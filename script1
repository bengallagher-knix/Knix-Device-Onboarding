<#
    Finds uninstall entries across BOTH machine hives and every loaded user
    hive. Per-user installs (Slack is the classic one) live under HKU and are
    invisible to a plain HKLM search.
#>
function Get-UninstallEntry {
    param([Parameter(Mandatory)][string]$NameLike)

    $roots = @(
        @{ Path = 'HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall\*';            Scope = 'machine' },
        @{ Path = 'HKLM:\SOFTWARE\WOW6432Node\Microsoft\Windows\CurrentVersion\Uninstall\*'; Scope = 'machine (x86)' }
    )

    Get-ChildItem 'Registry::HKEY_USERS' -ErrorAction SilentlyContinue |
        Where-Object { $_.PSChildName -match '^S-1-5-21-\d+-\d+-\d+-\d+$' } |
        ForEach-Object {
            $roots += @{
                Path  = "Registry::HKEY_USERS\$($_.PSChildName)\Software\Microsoft\Windows\CurrentVersion\Uninstall\*"
                Scope = "user $($_.PSChildName)"
            }
        }

    $results = @()
    foreach ($root in $roots) {
        try {
            $results += Get-ItemProperty -Path $root.Path -ErrorAction SilentlyContinue |
                        Where-Object { $_.DisplayName -like $NameLike } |
                        ForEach-Object {
                            [pscustomobject]@{
                                DisplayName        = $_.DisplayName
                                DisplayVersion     = $_.DisplayVersion
                                UninstallString    = $_.UninstallString
                                QuietUninstallString = $_.QuietUninstallString
                                InstallLocation    = $_.InstallLocation
                                Scope              = $root.Scope
                                KeyPath            = $_.PSPath
                            }
                        }
        } catch { }
    }
    return $results
}

function Get-WingetPath {
    try {
        $p = Get-ChildItem -Path (Join-Path $env:ProgramFiles 'WindowsApps') -Filter 'winget.exe' -Recurse -ErrorAction SilentlyContinue | Where-Object { $_.FullName -like '*Microsoft.DesktopAppInstaller*' } | Sort-Object FullName -Descending | Select-Object -First 1
        if ($p) { return $p.FullName }
    } catch { }
    return $null
}

<#
    Splits an uninstall string into the executable and its baked-in arguments.
    Going through cmd.exe mangles quoting on paths with spaces, so the exe is
    launched directly instead.
#>
function Get-ExeAndArgs {
    param([Parameter(Mandatory)][string]$CommandLine)

    $s = $CommandLine.Trim()

    if ($s.StartsWith('"')) {
        $end = $s.IndexOf('"', 1)
        if ($end -gt 0) {
            return [pscustomobject]@{
                Exe  = $s.Substring(1, $end - 1)
                Args = $s.Substring($end + 1).Trim()
            }
        }
    }

    $m = [regex]::Match($s, '^(?<exe>.*?\.exe)\b\s*(?<rest>.*)$', [Text.RegularExpressions.RegexOptions]::IgnoreCase)
    if ($m.Success) {
        return [pscustomobject]@{ Exe = $m.Groups['exe'].Value.Trim(); Args = $m.Groups['rest'].Value.Trim() }
    }

    return [pscustomobject]@{ Exe = $s; Args = '' }
}

<#
    Runs an uninstaller without ever waiting on a dialog nobody can see.

    Atera runs as SYSTEM in session 0. Any uninstaller that pops a window there
    blocks until the timeout, because the window is drawn on a desktop with no
    human attached. Defences:

      * SHORT per-attempt timeout. A stuck uninstaller is killed in 90 seconds,
        not 15 minutes, and its whole process tree goes with it.
      * SEVERAL silent-switch conventions are tried in turn - NSIS, Inno Setup,
        InstallShield, MSI-style - because vendors rarely document which one
        their uninstaller actually uses. Guessing once is how this hung.
      * Success is judged by the app DISAPPEARING from the registry, not by an
        exit code. GUI uninstallers routinely return 0 having done nothing.
      * Two consecutive hangs means the uninstaller is interactive-only, so it
        stops rather than burning the rest of the budget.
      * winget uninstall as a last resort.
#>
function Invoke-UninstallEntry {
    param(
        [Parameter(Mandatory)]$Entry,
        [int]$TimeoutSec = 90,
        [string]$VerifyNameLike
    )

    $name = $Entry.DisplayName
    if (-not $VerifyNameLike) { $VerifyNameLike = $name }

    $cmd = $Entry.QuietUninstallString
    if (-not $cmd) { $cmd = $Entry.UninstallString }

    if (-not $cmd) {
        Write-Log "$name has no uninstall string - skipping." 'WARN'
        return $false
    }

    # --- MSI products: rebuild the command rather than trust the stored one ---
    if ($cmd -match '\{[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}\}') {
        $productCode = $Matches[0]
        Write-Log "Uninstalling $name via MSI product code $productCode"
        $code = Invoke-Native -FilePath 'msiexec.exe' -TimeoutSec 600 -Label "uninstall-$name" -Arguments @('/X', $productCode, '/qn', '/norestart')
        if ($code -in @(0,1605,1614,1641,3010)) {
            if ($code -in @(1641,3010)) { $Script:RebootNeeded = $true }
            Write-Log "$name removed (exit $code)." 'SUCCESS'
            return $true
        }
        Write-Log "$name MSI uninstall returned $code." 'WARN'
        return $false
    }

    # --- EXE uninstallers -----------------------------------------------------
    $parsed = Get-ExeAndArgs -CommandLine $cmd

    if (-not (Test-Path $parsed.Exe)) {
        Write-Log "$name uninstaller is not on disk: $($parsed.Exe)" 'WARN'
        return $false
    }

    $baked = $parsed.Args
    $attempts = New-Object System.Collections.ArrayList

    # A vendor-supplied quiet string is tried first, exactly as written.
    if ($Entry.QuietUninstallString) { [void]$attempts.Add($baked) }

    # /S          NSIS
    # /VERYSILENT Inno Setup (with message boxes suppressed)
    # /s          InstallShield and various others
    # /quiet      MSI-style wrappers
    # --silent    Chromium-style and newer vendor installers
    foreach ($sw in @(
        '/S',
        '/VERYSILENT /SUPPRESSMSGBOXES /NORESTART',
        '/s',
        '/quiet /norestart',
        '--silent',
        '/uninstall /quiet',          # Advanced Installer bootstrappers
        '/x /qn',                     # MSI wrapper style
        '/exenoui /qn',               # Advanced Installer, no bootstrapper UI
        '-s -uninst',                 # older InstallShield
        '/SILENT /NORESTART'
    )) {
        $candidate = ("$baked $sw").Trim()
        if (-not $attempts.Contains($candidate)) { [void]$attempts.Add($candidate) }
    }

    $attemptNumber = 0
    $consecutiveHangs = 0

    foreach ($argString in $attempts) {

        $attemptNumber++
        Write-Log "$name uninstall attempt $attemptNumber of $($attempts.Count): $($parsed.Exe) $argString"

        if ([string]::IsNullOrWhiteSpace($argString)) {
            $code = Invoke-Native -FilePath $parsed.Exe -TimeoutSec $TimeoutSec -Label "uninstall-$attemptNumber"
        }
        else {
            $code = Invoke-Native -FilePath $parsed.Exe -TimeoutSec $TimeoutSec -Label "uninstall-$attemptNumber" -Arguments @($argString)
        }

        if ($code -eq -1) {
            $consecutiveHangs++
            Write-Log "Attempt $attemptNumber hung and was killed - that switch is not silent for this uninstaller." 'WARN'
        }
        else {
            $consecutiveHangs = 0
        }

        Start-Sleep -Seconds 3

        if (@(Get-UninstallEntry -NameLike $VerifyNameLike).Count -eq 0) {
            Write-Log "$name is gone after attempt $attemptNumber (exit $code)." 'SUCCESS'
            if ($code -in @(1641,3010)) { $Script:RebootNeeded = $true }
            return $true
        }

        Write-Log "$name still present after attempt $attemptNumber (exit $code)." 'WARN'

        if ($consecutiveHangs -ge 2) {
            Write-Log "$name hung twice in a row - its uninstaller needs an interactive desktop. Giving up on switch guessing." 'ERROR'
            break
        }
    }

    # --- Last resort: winget --------------------------------------------------
    $winget = Get-WingetPath
    if ($winget) {
        Write-Log "Trying winget uninstall for $name..."
        $code = Invoke-Native -FilePath $winget -TimeoutSec 300 -Label 'winget-uninstall' -Arguments @('uninstall', '--name', $name, '--silent', '--accept-source-agreements', '--disable-interactivity')
        Start-Sleep -Seconds 3
        if (@(Get-UninstallEntry -NameLike $VerifyNameLike).Count -eq 0) {
            Write-Log "$name removed by winget." 'SUCCESS'
            return $true
        }
        Write-Log "winget did not remove $name (exit $code)." 'WARN'
    }

    Write-Log "$name could NOT be removed silently. Uninstaller: $($parsed.Exe)" 'ERROR'
    Write-Log 'Find the correct silent switch for that uninstaller and add it to the attempts list.' 'ERROR'
    return $false
}

<#
    Removes matching Appx/MSIX packages for every user and de-provisions them
    from the image so new profiles do not get them back.
#>
function Remove-AppxByPattern {
    param(
        [Parameter(Mandatory)][string[]]$Patterns,
        [switch]$DryRun
    )

    $removed = @()

    foreach ($pattern in $Patterns) {

        # Installed packages, all users.
        try {
            $pkgs = @(Get-AppxPackage -AllUsers -ErrorAction SilentlyContinue |
                      Where-Object { $_.Name -like $pattern })
            foreach ($pkg in $pkgs) {
                if ($DryRun) {
                    Write-Log "[DRY RUN] would remove Appx: $($pkg.Name) $($pkg.Version)" 'WARN'
                    $removed += $pkg.Name
                    continue
                }
                try {
                    Write-Log "Removing Appx package $($pkg.Name) $($pkg.Version) for all users..."
                    Remove-AppxPackage -Package $pkg.PackageFullName -AllUsers -ErrorAction Stop
                    $removed += $pkg.Name
                }
                catch {
                    Write-Log "Remove-AppxPackage failed for $($pkg.Name): $($_.Exception.Message)" 'WARN'
                }
            }
        } catch { }

        # Provisioned packages - stops it returning for new profiles.
        try {
            $prov = @(Get-AppxProvisionedPackage -Online -ErrorAction SilentlyContinue |
                      Where-Object { $_.DisplayName -like $pattern })
            foreach ($p in $prov) {
                if ($DryRun) {
                    Write-Log "[DRY RUN] would de-provision: $($p.DisplayName) $($p.Version)" 'WARN'
                    $removed += "$($p.DisplayName) (provisioned)"
                    continue
                }
                try {
                    Write-Log "De-provisioning $($p.DisplayName) $($p.Version)..."
                    Remove-AppxProvisionedPackage -Online -PackageName $p.PackageName -ErrorAction Stop | Out-Null
                    $removed += "$($p.DisplayName) (provisioned)"
                }
                catch {
                    Write-Log "De-provision failed for $($p.DisplayName): $($_.Exception.Message)" 'WARN'
                }
            }
        } catch { }
    }

    return @($removed | Sort-Object -Unique)
}

<#
    Last-resort removal for software whose uninstaller cannot be driven from
    session 0. Deletes the install directory, its uninstall registry key, Start
    Menu shortcuts and autostart entries.

    This is deliberately blunt. It is for OEM bloatware that refuses to leave,
    not for anything a user has data in. Every path is logged before deletion.
#>
function Remove-AppByForce {
    param(
        [Parameter(Mandatory)]$Entry,
        [switch]$DryRun
    )

    $name = $Entry.DisplayName
    Write-Log "FORCE REMOVAL of '$name' - its uninstaller could not be run silently." 'WARN'

    $removed = $false

    # --- 1. Work out the install directory ----------------------------------
    $dir = $null
    if ($Entry.InstallLocation -and (Test-Path $Entry.InstallLocation)) {
        $dir = $Entry.InstallLocation
    }
    else {
        $cmd = $Entry.QuietUninstallString
        if (-not $cmd) { $cmd = $Entry.UninstallString }
        if ($cmd) {
            $parsed = Get-ExeAndArgs -CommandLine $cmd
            if ($parsed.Exe -and (Test-Path $parsed.Exe)) { $dir = Split-Path $parsed.Exe -Parent }
        }
    }

    # --- 2. Kill anything running from that directory -----------------------
    if ($dir) {
        foreach ($proc in @(Get-Process -ErrorAction SilentlyContinue)) {
            try {
                if ($proc.Path -and $proc.Path.StartsWith($dir, [StringComparison]::OrdinalIgnoreCase)) {
                    if ($DryRun) { Write-Log "[DRY RUN] would kill $($proc.Name) (PID $($proc.Id))" 'WARN'; continue }
                    Stop-Process -Id $proc.Id -Force -ErrorAction SilentlyContinue
                    Write-Log "Killed $($proc.Name) (PID $($proc.Id)) running from the install folder."
                }
            } catch { }
        }
        Start-Sleep -Seconds 2
    }

    # --- 3. Delete the install directory ------------------------------------
    if ($dir -and (Test-Path $dir)) {
        # Refuse to touch anything that is not clearly a program folder.
        $safe = $dir -match '(?i)^[A-Z]:\\Program Files( \(x86\))?\\' -or $dir -match '(?i)^[A-Z]:\\ProgramData\\'
        if (-not $safe) {
            Write-Log "Refusing to force-delete '$dir' - it is not under Program Files or ProgramData." 'ERROR'
        }
        elseif ($DryRun) {
            Write-Log "[DRY RUN] would delete folder $dir" 'WARN'
            $removed = $true
        }
        else {
            try {
                Remove-Item -LiteralPath $dir -Recurse -Force -ErrorAction Stop
                Write-Log "Deleted install folder $dir" 'SUCCESS'
                $removed = $true
            }
            catch { Write-Log "Could not delete $dir : $($_.Exception.Message)" 'WARN' }
        }
    }

    # --- 4. Delete the uninstall registry key -------------------------------
    if ($Entry.KeyPath) {
        if ($DryRun) { Write-Log "[DRY RUN] would delete registry key $($Entry.KeyPath)" 'WARN' }
        else {
            try {
                Remove-Item -LiteralPath $Entry.KeyPath -Recurse -Force -ErrorAction Stop
                Write-Log "Deleted uninstall registry key for $name." 'SUCCESS'
                $removed = $true
            }
            catch { Write-Log "Could not delete the registry key: $($_.Exception.Message)" 'WARN' }
        }
    }

    # --- 5. Start Menu shortcuts --------------------------------------------
    $menus = @(
        (Join-Path $env:ProgramData 'Microsoft\Windows\Start Menu\Programs'),
        (Join-Path $env:PUBLIC 'Desktop')
    )
    foreach ($menu in $menus) {
        if (-not (Test-Path $menu)) { continue }
        Get-ChildItem -Path $menu -Recurse -ErrorAction SilentlyContinue |
            Where-Object { $_.Name -like "*$($name.Split(' ')[0])*" -and $_.Extension -in @('.lnk','.url') } |
            ForEach-Object {
                if ($DryRun) { Write-Log "[DRY RUN] would delete shortcut $($_.FullName)" 'WARN'; return }
                Remove-Item -LiteralPath $_.FullName -Force -ErrorAction SilentlyContinue
                Write-Log "Removed shortcut $($_.FullName)"
            }
    }

    return $removed
}



function Stop-ProcessByName {
    param([Parameter(Mandatory)][string[]]$Names, [switch]$DryRun)
    $stopped = @()
    foreach ($n in $Names) {
        $procs = @(Get-Process -Name $n -ErrorAction SilentlyContinue)
        foreach ($p in $procs) {
            if ($DryRun) { Write-Log "[DRY RUN] would stop process $($p.Name) (PID $($p.Id))" 'WARN'; $stopped += $p.Name; continue }
            try {
                Stop-Process -Id $p.Id -Force -ErrorAction Stop
                Write-Log "Stopped process $($p.Name) (PID $($p.Id))."
                $stopped += $p.Name
            }
            catch { Write-Log "Could not stop $($p.Name): $($_.Exception.Message)" 'WARN' }
        }
    }
    if ($stopped) { Start-Sleep -Seconds 3 }
    return @($stopped | Sort-Object -Unique)
}


function Invoke-MsiInstall {
    param(
        [Parameter(Mandatory)][string]$MsiPath,
        [string[]]$Properties = @(),
        [int]$TimeoutSec = 900,
        [string]$Label = 'msi'
    )
    $msiLog  = Join-Path $Script:LogDir ("msi_{0}.log" -f ($Label -replace '[^A-Za-z0-9_-]','_'))
    $msiArgs = @('/i', "`"$MsiPath`"") + $Properties + @('/qn','/norestart','/L*v', "`"$msiLog`"")
    $code    = Invoke-Native -FilePath 'msiexec.exe' -Arguments $msiArgs -TimeoutSec $TimeoutSec -Label $Label

    switch ($code) {
        0     { Write-Log "$Label installed." 'SUCCESS'; return $true }
        1641  { Write-Log "$Label installed; reboot initiated by installer." 'WARN'; $Script:RebootNeeded = $true; return $true }
        3010  { Write-Log "$Label installed; reboot required." 'WARN'; $Script:RebootNeeded = $true; return $true }
        1618  { Write-Log "$Label failed: another Windows Installer session is busy (1618)." 'ERROR'; return $false }
        1603  { Write-Log "$Label failed: MSI fatal error 1603. See $msiLog" 'ERROR'; return $false }
        -1    { Write-Log "$Label timed out and was killed." 'ERROR'; return $false }
        default { Write-Log "$Label failed with exit code $code. See $msiLog" 'ERROR'; return $false }
    }
}

<#
    Waits for the Windows Installer mutex to free up so back-to-back MSI
    installs do not fail with 1618.
#>
function Wait-ForMsiIdle {
    param([int]$TimeoutSec = 300)

    $sw = [Diagnostics.Stopwatch]::StartNew()
    while ($sw.Elapsed.TotalSeconds -lt $TimeoutSec) {

        $busy = $false
        $mutex = $null
        try {
            # _MSIExecute exists only while an install is in progress.
            $mutex = [System.Threading.Mutex]::OpenExisting('Global\_MSIExecute')
            $busy = $true
        }
        catch [System.Threading.WaitHandleCannotBeOpenedException] { $busy = $false }
        catch { $busy = $true }
        finally { if ($mutex) { $mutex.Dispose() } }

        if (-not $busy) { return $true }
        Write-Log 'Another Windows Installer session is running - waiting...'
        Start-Sleep -Seconds 10
    }

    Write-Log 'Windows Installer still busy after wait; continuing anyway.' 'WARN'
    return $false
}

function Test-PendingReboot {
    $paths = @(
        'HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion\Component Based Servicing\RebootPending',
        'HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion\WindowsUpdate\Auto Update\RebootRequired'
    )
    foreach ($p in $paths) { if (Test-Path $p) { return $true } }
    $pfro = Get-ItemProperty -Path 'HKLM:\SYSTEM\CurrentControlSet\Control\Session Manager' -Name 'PendingFileRenameOperations' -ErrorAction SilentlyContinue
    return [bool]$pfro.PendingFileRenameOperations
}

