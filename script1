<#
.SYNOPSIS
    Knix Windows device onboarding - single idempotent Atera script.

.DESCRIPTION
    Replaces six separate Atera scripts with one run. Every step is:
      - Idempotent      : checks state first, acts only when something is wrong.
      - Isolated        : a failure or hang in one step can never stop the others.
      - Time-boxed      : every external process and download has a hard timeout
                          and is killed (process tree) if it overruns.
      - Logged          : C:\ProgramData\Knix\Logs\Onboarding.log plus an Atera
                          summary table at the end.
      - Alerted         : posts failures (and optionally every run) to Slack via
                          a bot token. See the SLACK ALERTING block at the top.
                          Slack problems are logged and swallowed - they can
                          never affect the onboarding result.

    Steps run in this order (security agents first, BitLocker last):
      1. Malwarebytes / ThreatDown Endpoint Agent
      2. Splashtop Streamer (with deployment code applied)
      3. Core apps: Google Chrome, Slack, Google Drive for Desktop
      4. Purge Lenovo AI (AI Now / Qira)
      5. Knix Service Desk desktop shortcut
      6. Corporate wallpaper
      7. BitLocker (never reboots unless -AllowReboot is passed)

.NOTES
    Run as SYSTEM / Administrator. PowerShell 5.1.
    Exit 0 = all steps OK or already compliant. Exit 1 = at least one step failed.

    HOW TO RUN THIS - IT MATTERS
    ----------------------------
    This is a SCRIPT FILE. It has a param() block, so it must be executed as a
    file, not fed line by line into an interactive PowerShell prompt.

      RIGHT: Atera > Script Library > new script > UPLOAD this .ps1, then run
             it against the device. Atera saves it to disk and runs it with
             powershell.exe -File, which is correct.

      RIGHT: powershell.exe -ExecutionPolicy Bypass -File .\Knix-Device-Onboarding.ps1

      WRONG: pasting the text into Atera's "Run Command" console, or into an
             interactive PS window. Those feed it line by line; param() is only
             legal as the first statement of a file, so the whole thing fails
             to parse and NOTHING runs - silently.

    Confirm it parses before deploying:
      $e=$null
      [void][System.Management.Automation.Language.Parser]::ParseFile(
          'C:\path\Knix-Device-Onboarding.ps1',[ref]$null,[ref]$e); $e

    The first line of output is always "=== KNIX ONBOARDING STARTING ... ===".
    No such line means the body never ran.
#>

[CmdletBinding()]
param(

# ############################################################################
# #                                                                          #
# #                  SLACK ALERTING - FILL THESE TWO IN                      #
# #                                                                          #
# #  1. Create a Slack app at https://api.slack.com/apps                     #
# #  2. OAuth & Permissions -> Bot Token Scopes -> add  chat:write           #
# #  3. Install to workspace, copy the Bot User OAuth Token (xoxb-...)       #
# #  4. Invite the bot to the channel:  /invite @YourBotName                 #
# #                                                                          #
# #  Leave the token blank to disable Slack entirely - the script still      #
# #  runs normally and just logs that alerting is off.                       #
# #                                                                          #
# #  Better: set these as Atera script PARAMETERS instead of hardcoding,     #
# #  so the token never sits in the script body.                             #
# #                                                                          #
# ############################################################################

    # Bot User OAuth Token, e.g. 'xoxb-1234567890-...'
    #
    # LEAVE THIS BLANK IN GIT. A committed Slack token is a leaked token:
    # Slack's secret scanner auto-revokes tokens found in public repos, and
    # rewriting git history to remove one is painful. Supply it at runtime via
    # the KNIX_SLACK_TOKEN environment variable, which the bootstrap sets.
    # A value here (if you insist) still wins over the environment variable.
    [string]$SlackBotToken = '',

    # Channel ID (preferred, e.g. 'C09ABCDEFGH') or name (e.g. '#it-alerts').
    # NOT a secret - safe to commit. Can also come from KNIX_SLACK_CHANNEL.
    [string]$SlackChannel = '',

    # ------------------------------------------------------------------------
    # BITLOCKER KEY ESCROW -> GOOGLE SHEET
    #
    # Deploy Knix-BitLocker-Sheet.gs as an Apps Script web app bound to the
    # sheet, then put its /exec URL and the shared secret in the BOOTSTRAP (in
    # Atera), not here - the bootstrap sets KNIX_SHEET_URL / KNIX_SHEET_SECRET
    # and this script picks them up, so neither reaches GitHub.
    #
    # The endpoint only writes. It cannot read the sheet back, so a device that
    # gets compromised cannot enumerate everyone else's recovery keys.
    # ------------------------------------------------------------------------
    [string]$BitLockerSheetUrl = '',

    [string]$BitLockerSheetSecret = '',

    # Optional mention prepended to failure alerts only.
    # Examples: '<!channel>'  '<!here>'  '<@U01ABCDEFGH>'  '<!subteam^S01ABC|@it-team>'
    [string]$SlackMention = '',

    # Always   = post every run, including a green "device ready" confirmation
    #            once all post-install checks pass (default)
    # Failures = post only when a step failed, a check failed, or a step was
    #            skipped - silent on a clean device
    # Never    = disable posting without clearing the token
    [ValidateSet('Always','Failures','Never')]
    [string]$SlackNotify = 'Always',

    # Also post an immediate message the moment a step fails, instead of
    # waiting for the end-of-run summary.
    [switch]$SlackPerStep,

# ############################################################################
# #                        END SLACK CONFIGURATION                           #
# ############################################################################

    [string]$SplashtopDeployCode = 'TKXZT7R7SSSP',

    [string]$SplashtopInstallerUrl = 'https://github.com/bengallagher-knix/splashtopdeployment/releases/download/splashtop-v1/Splashtop_Streamer_Windows_DEPLOY_INSTALLER_v3.8.6.0_TKXZT7R7SSSP.exe',

    [string]$MalwarebytesToken = 'ed558c71-63f0-40c2-80c0-ee5ca74ec18e',

    [string]$MalwarebytesGroupId = '43ebd935-dc34-4472-b192-7e0827985b61',

    [string]$WallpaperUrl = 'https://raw.githubusercontent.com/bengallagher-knix/knix-pride-wallpaper/main/knixwallpaper.jpg',

    [string]$ServiceDeskUrl = 'https://knixwear.atlassian.net/servicedesk/customer/portals',

    # ------------------------------------------------------------------------
    # DEBLOAT - what gets purged
    #
    # These patterns drive BOTH the Appx removal and the Win32 uninstall
    # search, so keep them tight. Anything matched is logged before it is
    # touched - run with -RemovalDryRun first on a new model to see the list.
    # ------------------------------------------------------------------------
    [string[]]$LenovoAiPatterns = @(
        '*AINow*',
        '*AI Now*',
        '*Qira*',
        '*LenovoAI*'
    ),

    # List matches and change nothing. Use this on the first device of a new
    # model line before letting it purge.
    [switch]$RemovalDryRun,

    # Step names to skip, e.g. -Skip BitLocker,Wallpaper
    [ValidateSet('Malwarebytes','Splashtop','CoreApps','RemoveLenovoAI','ServiceDesk','Wallpaper','BitLocker')]
    [string[]]$Skip = @(),

    # BitLocker needs a reboot to finish. OFF by default so the script never
    # reboots a machine out from under the rest of the onboarding.
    [switch]$AllowReboot
)

# First thing that runs. If you do not see this line in the output, the script
# body never executed - it was a parse/invocation problem, not a logic problem.
Write-Host "=== KNIX ONBOARDING STARTING $(Get-Date -Format 'yyyy-MM-dd HH:mm:ss') on $env:COMPUTERNAME ==="

# Token handed over by the 64-bit relaunch below, so it never appears on a
# command line.
if ([string]::IsNullOrWhiteSpace($SlackBotToken) -and $env:KNIX_SLACK_TOKEN) {
    $SlackBotToken = $env:KNIX_SLACK_TOKEN
}
if ([string]::IsNullOrWhiteSpace($SlackChannel) -and $env:KNIX_SLACK_CHANNEL) {
    $SlackChannel = $env:KNIX_SLACK_CHANNEL
}
if ([string]::IsNullOrWhiteSpace($BitLockerSheetUrl) -and $env:KNIX_SHEET_URL) {
    $BitLockerSheetUrl = $env:KNIX_SHEET_URL
}
if ([string]::IsNullOrWhiteSpace($BitLockerSheetSecret) -and $env:KNIX_SHEET_SECRET) {
    $BitLockerSheetSecret = $env:KNIX_SHEET_SECRET
}

# ============================================================================
# GLOBAL BEHAVIOUR
# ============================================================================
# Continue, NOT Stop. A stray non-terminating error must never abort the run.
# Individual calls that must succeed use -ErrorAction Stop inside a try/catch.
$ErrorActionPreference = 'Continue'
$ProgressPreference    = 'SilentlyContinue'   # huge speed-up for Invoke-WebRequest

$Script:Root     = 'C:\ProgramData\Knix'
$Script:LogDir   = Join-Path $Script:Root 'Logs'
$Script:TempDir  = Join-Path $Script:Root 'Temp'
$Script:StateDir = Join-Path $Script:Root 'State'
$Script:LogFile  = Join-Path $Script:LogDir 'Onboarding.log'
$Script:Results  = New-Object System.Collections.ArrayList
$Script:RebootNeeded = $false

foreach ($d in @($Script:Root, $Script:LogDir, $Script:TempDir, $Script:StateDir)) {
    if (-not (Test-Path $d)) {
        New-Item -Path $d -ItemType Directory -Force | Out-Null
    }
}

# ============================================================================
# 64-BIT GUARD
# Atera can invoke 32-bit PowerShell. Under WOW64 the registry and Program Files
# are redirected, which makes installs "succeed" but detection fail forever.
# ============================================================================
if ([Environment]::Is64BitOperatingSystem -and -not [Environment]::Is64BitProcess) {
    $ps64 = Join-Path $env:WINDIR 'SysNative\WindowsPowerShell\v1.0\powershell.exe'
    if ((Test-Path $ps64) -and $PSCommandPath) {
        $relaunch = @('-NoProfile','-NonInteractive','-ExecutionPolicy','Bypass','-File', "`"$PSCommandPath`"")
        foreach ($kvp in $PSBoundParameters.GetEnumerator()) {

            # Never put the Slack token on a command line - it would be visible
            # in the process list. Hand it over through the inherited environment.
            if ($kvp.Key -eq 'SlackBotToken') {
                $env:KNIX_SLACK_TOKEN = $kvp.Value
                continue
            }

            if ($kvp.Value -is [switch]) {
                if ($kvp.Value.IsPresent) { $relaunch += "-$($kvp.Key)" }
            }
            elseif ($kvp.Value -is [array]) {
                $relaunch += "-$($kvp.Key)"
                foreach ($v in $kvp.Value) { $relaunch += "$v" }
            }
            else {
                $relaunch += "-$($kvp.Key)"
                $relaunch += "`"$($kvp.Value)`""
            }
        }
        Write-Host 'Relaunching in 64-bit PowerShell...'
        & $ps64 $relaunch
        exit $LASTEXITCODE
    }
}

# ============================================================================
# HELPERS
# ============================================================================

function Write-Log {
    param(
        [string]$Message,
        [ValidateSet('INFO','SUCCESS','WARN','ERROR','STEP')]
        [string]$Level = 'INFO'
    )
    $line = "{0} [{1}] {2}" -f (Get-Date -Format 'yyyy-MM-dd HH:mm:ss'), $Level, $Message
    Write-Host $line
    try { Add-Content -Path $Script:LogFile -Value $line -ErrorAction Stop } catch { }
}

function Test-IsAdmin {
    $id = [Security.Principal.WindowsIdentity]::GetCurrent()
    (New-Object Security.Principal.WindowsPrincipal($id)).IsInRole(
        [Security.Principal.WindowsBuiltInRole]::Administrator)
}

# ----------------------------------------------------------------------------
# SLACK
# Alerting must never be able to break onboarding: every call is time-boxed,
# fully wrapped, and failures are logged and swallowed.
# ----------------------------------------------------------------------------

function Test-SlackConfigured {
    if ($SlackNotify -eq 'Never')            { return $false }
    if ([string]::IsNullOrWhiteSpace($SlackBotToken)) { return $false }
    if ([string]::IsNullOrWhiteSpace($SlackChannel))  { return $false }
    if ($SlackBotToken -notmatch '^xox[bp]-') {
        Write-Log 'SlackBotToken does not look like a bot token (expected xoxb-...). Slack disabled.' 'WARN'
        return $false
    }
    return $true
}

<#
    Posts to Slack via chat.postMessage.
    NOTE: Slack returns HTTP 200 even on failure, so the ok field is checked.
    NOTE: never pass secrets (BitLocker recovery keys, tokens) into $Text.
#>
function Send-SlackMessage {
    param(
        [Parameter(Mandatory)][string]$Text,   # notification/fallback text
        [array]$Blocks,                        # optional Block Kit payload
        [int]$TimeoutSec = 20
    )

    if (-not (Test-SlackConfigured)) { return $false }

    $payload = @{
        channel = $SlackChannel
        text    = $Text
    }
    if ($Blocks) { $payload['blocks'] = $Blocks }

    try {
        $body = $payload | ConvertTo-Json -Depth 10 -Compress

        # Force UTF-8 so emoji and accented characters survive the trip.
        $bytes = [Text.Encoding]::UTF8.GetBytes($body)

        $response = Invoke-RestMethod -Uri 'https://slack.com/api/chat.postMessage' -Method Post -Headers @{ Authorization = "Bearer $SlackBotToken" } -ContentType 'application/json; charset=utf-8' -Body $bytes -TimeoutSec $TimeoutSec -UseBasicParsing -ErrorAction Stop

        if ($response.ok) {
            Write-Log "Slack alert posted to $SlackChannel."
            return $true
        }

        # Common errors: invalid_auth, channel_not_found, not_in_channel,
        # missing_scope (bot needs chat:write and must be invited to the channel).
        Write-Log "Slack API rejected the message: $($response.error)" 'WARN'
        return $false
    }
    catch {
        Write-Log "Slack post failed: $($_.Exception.Message)" 'WARN'
        return $false
    }
}

function Send-SlackStepFailure {
    param(
        [Parameter(Mandatory)][string]$StepName,
        [string]$Detail
    )

    if (-not (Test-SlackConfigured)) { return }

    $prefix = if ($SlackMention) { "$SlackMention " } else { '' }
    $text   = "$prefix:x: Onboarding step *$StepName* failed on *$env:COMPUTERNAME*"

    $blocks = @(
        @{
            type = 'section'
            text = @{ type = 'mrkdwn'; text = $text }
        },
        @{
            type   = 'section'
            fields = @(
                @{ type = 'mrkdwn'; text = "*Device*`n$env:COMPUTERNAME" },
                @{ type = 'mrkdwn'; text = "*Step*`n$StepName" }
            )
        },
        @{
            type = 'section'
            text = @{ type = 'mrkdwn'; text = "*Detail*`n``````$(Format-SlackText $Detail)``````" }
        }
    )

    Send-SlackMessage -Text $text -Blocks $blocks | Out-Null
}

function Format-SlackText {
    param([string]$Value, [int]$MaxLength = 700)
    if ([string]::IsNullOrWhiteSpace($Value)) { return 'n/a' }
    $clean = $Value -replace '`', "'"          # backticks would break code fences
    # Hard stop: a BitLocker recovery key must never reach Slack.
    $clean = $clean -replace '\d{6}(-\d{6}){7}', '[REDACTED-RECOVERY-KEY]'
    $clean = $clean -replace 'xox[baprs]-[A-Za-z0-9-]+', '[REDACTED-TOKEN]'
    if ($clean.Length -gt $MaxLength) { $clean = $clean.Substring(0, $MaxLength) + ' ...[truncated]' }
    return $clean
}

function Send-SlackSummary {
    param(
        [Parameter(Mandatory)][array]$Results,
        [array]$Health = @(),
        [bool]$RebootNeeded
    )

    if (-not (Test-SlackConfigured)) {
        Write-Log 'Slack alerting is not configured - skipping notification.'
        return
    }

    $failed    = @($Results | Where-Object { $_.Status -eq 'FAILED' })
    $pending   = @($Results | Where-Object { $_.Status -in @('PENDING','SKIPPED') })
    $unhealthy = @($Health  | Where-Object { $_.Healthy -eq $false })

    $allGood = ($failed.Count -eq 0 -and $unhealthy.Count -eq 0)

    if ($SlackNotify -eq 'Failures' -and $allGood -and $pending.Count -eq 0) {
        Write-Log 'Clean run and SlackNotify=Failures - nothing posted to Slack.'
        return
    }

    if ($failed.Count -gt 0 -or $unhealthy.Count -gt 0) {
        $icon   = ':rotating_light:'
        $header = "Device NOT ready: $env:COMPUTERNAME"
    }
    elseif ($pending.Count -gt 0) {
        $icon   = ':warning:'
        $header = "Device ready with warnings: $env:COMPUTERNAME"
    }
    else {
        $icon   = ':white_check_mark:'
        $header = "Device ready: $env:COMPUTERNAME"
    }

    $mention = if ($SlackMention -and $failed.Count -gt 0) { "$SlackMention " } else { '' }

    # Fixed-width step table so it stays readable on mobile.
    $table = ($Results | ForEach-Object {
        '{0,-13} {1,-11} {2,6}s  {3}' -f $_.Step, $_.Status, $_.Seconds, (Format-SlackText $_.Detail 90)
    }) -join "`n"

    $os     = (Get-CimInstance Win32_OperatingSystem -ErrorAction SilentlyContinue).Caption
    $serial = (Get-CimInstance Win32_BIOS -ErrorAction SilentlyContinue).SerialNumber
    $model  = (Get-CimInstance Win32_ComputerSystem -ErrorAction SilentlyContinue).Model

    $blocks = @(
        @{
            type = 'header'
            text = @{ type = 'plain_text'; text = "$icon $header"; emoji = $true }
        },
        @{
            type   = 'section'
            fields = @(
                @{ type = 'mrkdwn'; text = "*Device*`n$env:COMPUTERNAME" },
                @{ type = 'mrkdwn'; text = "*Model / Serial*`n$model / $serial" },
                @{ type = 'mrkdwn'; text = "*OS*`n$os" },
                @{ type = 'mrkdwn'; text = "*Reboot required*`n$RebootNeeded" }
            )
        }
    )

    if ($mention) {
        $blocks += @{ type = 'section'; text = @{ type = 'mrkdwn'; text = $mention } }
    }

    if ($failed.Count -gt 0) {
        $failDetail = ($failed | ForEach-Object { "- *$($_.Step)*: $(Format-SlackText $_.Detail 200)" }) -join "`n"
        $blocks += @{
            type = 'section'
            text = @{ type = 'mrkdwn'; text = "*Failed steps*`n$failDetail" }
        }
    }

    # Post-flight verification - this is the actual "is the device working"
    # answer, read back from the machine rather than inferred from the steps.
    if ($Health.Count -gt 0) {
        $healthLines = ($Health | ForEach-Object {
            $mark = switch ($_.Healthy) {
                $true   { ':white_check_mark:' }
                $false  { ':x:' }
                default { ':heavy_minus_sign:' }
            }
            "$mark *$($_.Name)* - $(Format-SlackText $_.Detail 90)"
        }) -join "`n"

        $verdict = if ($allGood) {
            ':tada: *All checks passed - this device is in full working condition.*'
        } else {
            ":x: *$($unhealthy.Count) check(s) failed - this device needs attention.*"
        }

        $blocks += @{
            type = 'section'
            text = @{ type = 'mrkdwn'; text = "*Post-install verification*`n$healthLines`n`n$verdict" }
        }
    }

    $blocks += @{
        type = 'section'
        text = @{ type = 'mrkdwn'; text = "*Full result*`n``````$table``````" }
    }

    $blocks += @{
        type     = 'context'
        elements = @(
            @{ type = 'mrkdwn'; text = "Log: ``$Script:LogFile``  |  $(Get-Date -Format 'yyyy-MM-dd HH:mm:ss')" }
        )
    }

    # Fallback text is what shows in the notification and on unsupported clients.
    $fallback = "$mention$icon $header"
    if ($failed.Count -gt 0)    { $fallback += " - failed steps: $(($failed | ForEach-Object { $_.Step }) -join ', ')" }
    if ($unhealthy.Count -gt 0) { $fallback += " - failed checks: $(($unhealthy | ForEach-Object { $_.Name }) -join ', ')" }
    if ($allGood)               { $fallback += ' - all post-install checks passed' }

    Send-SlackMessage -Text $fallback -Blocks $blocks | Out-Null
}

<#
    Runs a native process with a HARD timeout. On timeout the whole process tree
    is killed. This is the main defence against a hung installer taking the
    onboarding down with it. Returns the exit code, or -1 if it had to be killed.
#>
function Invoke-Native {
    param(
        [Parameter(Mandatory)][string]$FilePath,
        [string[]]$Arguments = @(),
        [int]$TimeoutSec = 600,
        [string]$Label
    )

    if (-not $Label) { $Label = Split-Path $FilePath -Leaf }

    $outFile = Join-Path $Script:LogDir ("proc_{0}_{1}.out.log" -f ($Label -replace '[^A-Za-z0-9_-]','_'), (Get-Date -Format 'HHmmss'))
    $errFile = [IO.Path]::ChangeExtension($outFile, 'err.log')

    Write-Log "Running: $FilePath $($Arguments -join ' ')  (timeout ${TimeoutSec}s)"

    try {
        $spArgs = @{
            FilePath               = $FilePath
            PassThru               = $true
            NoNewWindow            = $true
            RedirectStandardOutput = $outFile
            RedirectStandardError  = $errFile
            ErrorAction            = 'Stop'
        }
        if ($Arguments.Count -gt 0) { $spArgs['ArgumentList'] = $Arguments }

        $proc = Start-Process @spArgs
    }
    catch {
        Write-Log "Could not start $FilePath : $($_.Exception.Message)" 'ERROR'
        return -2
    }

    if (-not $proc.WaitForExit($TimeoutSec * 1000)) {
        Write-Log "$Label exceeded ${TimeoutSec}s - killing process tree (PID $($proc.Id))." 'ERROR'
        try { & taskkill.exe /PID $proc.Id /T /F 2>&1 | Out-Null } catch { }
        return -1
    }

    $code = $proc.ExitCode

    foreach ($f in @($outFile, $errFile)) {
        if (Test-Path $f) {
            $content = (Get-Content $f -Raw -ErrorAction SilentlyContinue)
            if ($content -and $content.Trim()) {
                $snippet = $content.Trim()
                if ($snippet.Length -gt 1500) { $snippet = $snippet.Substring(0,1500) + ' ...[truncated]' }
                Write-Log "$Label output: $snippet"
            }
            Remove-Item $f -Force -ErrorAction SilentlyContinue
        }
    }

    Write-Log "$Label exit code: $code"
    return $code
}

<#
    Runs a process that may never exit, and stops waiting once the job is
    actually done.

    Some installers launch their service or tray app and leave the parent
    process resident forever - Splashtop's Streamer is the classic example. A
    plain WaitForExit then blocks for the whole timeout even though the install
    finished in thirty seconds. Others pop a dialog invisible from session 0.

    So instead of waiting on the process, this polls a success CONDITION. The
    moment the condition is true the work is done, whatever the process is
    doing. The process gets a grace period to tidy up, then its tree is killed.

    Returns a hashtable: Success, ExitCode, Killed, Seconds.
#>
function Invoke-NativeUntil {
    param(
        [Parameter(Mandatory)][string]$FilePath,
        [string[]]$Arguments = @(),
        [Parameter(Mandatory)][scriptblock]$SuccessTest,
        [int]$TimeoutSec = 420,
        [int]$PollSeconds = 5,
        [int]$GraceSeconds = 45,
        [string]$Label
    )

    if (-not $Label) { $Label = Split-Path $FilePath -Leaf }

    $outFile = Join-Path $Script:LogDir ("proc_{0}_{1}.out.log" -f ($Label -replace '[^A-Za-z0-9_-]','_'), (Get-Date -Format 'HHmmss'))
    $errFile = [IO.Path]::ChangeExtension($outFile, 'err.log')

    Write-Log "Running (polled): $FilePath $($Arguments -join ' ')  (max ${TimeoutSec}s)"

    try {
        $spArgs = @{
            FilePath               = $FilePath
            PassThru               = $true
            NoNewWindow            = $true
            RedirectStandardOutput = $outFile
            RedirectStandardError  = $errFile
            ErrorAction            = 'Stop'
        }
        if ($Arguments.Count -gt 0) { $spArgs['ArgumentList'] = $Arguments }
        $proc = Start-Process @spArgs
    }
    catch {
        Write-Log "Could not start $FilePath : $($_.Exception.Message)" 'ERROR'
        return @{ Success = $false; ExitCode = -2; Killed = $false; Seconds = 0 }
    }

    $sw = [Diagnostics.Stopwatch]::StartNew()
    $satisfied = $false
    $satisfiedAt = 0

    while ($sw.Elapsed.TotalSeconds -lt $TimeoutSec) {

        Start-Sleep -Seconds $PollSeconds

        if (-not $satisfied) {
            try { $satisfied = [bool](& $SuccessTest) } catch { $satisfied = $false }
            if ($satisfied) {
                $satisfiedAt = $sw.Elapsed.TotalSeconds
                Write-Log "$Label : success condition met after $([math]::Round($satisfiedAt,0))s."
            }
        }

        if ($proc.HasExited) {
            Write-Log "$Label exited on its own after $([math]::Round($sw.Elapsed.TotalSeconds,0))s."
            break
        }

        if ($satisfied -and (($sw.Elapsed.TotalSeconds - $satisfiedAt) -ge $GraceSeconds)) {
            Write-Log "$Label still running ${GraceSeconds}s after succeeding - killing its process tree." 'WARN'
            try { & taskkill.exe /PID $proc.Id /T /F 2>&1 | Out-Null } catch { }
            Start-Sleep -Seconds 2
            break
        }
    }

    $killed = $false
    if (-not $proc.HasExited) {
        if (-not $satisfied) {
            Write-Log "$Label exceeded ${TimeoutSec}s without succeeding - killing its process tree." 'ERROR'
        }
        try { & taskkill.exe /PID $proc.Id /T /F 2>&1 | Out-Null } catch { }
        $killed = $true
        Start-Sleep -Seconds 2
    }

    $exitCode = -1
    try { if ($proc.HasExited) { $exitCode = $proc.ExitCode } } catch { }

    foreach ($f in @($outFile, $errFile)) {
        if (Test-Path $f) {
            $content = (Get-Content $f -Raw -ErrorAction SilentlyContinue)
            if ($content -and $content.Trim()) {
                $snippet = $content.Trim()
                if ($snippet.Length -gt 1000) { $snippet = $snippet.Substring(0,1000) + ' ...[truncated]' }
                Write-Log "$Label output: $snippet"
            }
            Remove-Item $f -Force -ErrorAction SilentlyContinue
        }
    }

    # One last look, in case it landed right at the end.
    if (-not $satisfied) {
        Start-Sleep -Seconds 5
        try { $satisfied = [bool](& $SuccessTest) } catch { }
    }

    $sw.Stop()
    return @{
        Success  = $satisfied
        ExitCode = $exitCode
        Killed   = $killed
        Seconds  = [math]::Round($sw.Elapsed.TotalSeconds, 0)
    }
}

<#
    Download with retries, a timeout, a minimum-size sanity check (catches HTML
    error pages), and a curl.exe fallback.
#>
function Invoke-Download {
    param(
        # Accepts several candidate sources. They are tried in order until one
        # yields a file that passes the size check - vendors move these URLs.
        [Parameter(Mandatory)][string[]]$Url,
        [Parameter(Mandatory)][string]$Destination,
        [int]$MinBytes = 100KB,
        [int]$TimeoutSec = 300,
        [int]$Retries = 2
    )

    $sourceNumber = 0

    foreach ($candidate in $Url) {

        $sourceNumber++
        Write-Log "Source $sourceNumber of $($Url.Count): $candidate"

        for ($attempt = 1; $attempt -le $Retries; $attempt++) {

            Remove-Item $Destination -Force -ErrorAction SilentlyContinue

            try {
                Write-Log "  Invoke-WebRequest attempt $attempt of $Retries..."
                Invoke-WebRequest -Uri $candidate -OutFile $Destination -UseBasicParsing -TimeoutSec $TimeoutSec -ErrorAction Stop
            }
            catch {
                Write-Log "  Invoke-WebRequest failed: $($_.Exception.Message)" 'WARN'
            }

            if ((Test-Path $Destination) -and ((Get-Item $Destination).Length -ge $MinBytes)) {
                $mb = [math]::Round((Get-Item $Destination).Length / 1MB, 2)
                Write-Log "Downloaded $mb MB to $Destination" 'SUCCESS'
                return $true
            }

            if (Test-Path $Destination) {
                $got = (Get-Item $Destination).Length
                Write-Log "  Got $got bytes, need at least $MinBytes - treating as a bad response." 'WARN'
            }

            # curl.exe ships in Windows 10 1803+ and copes with proxies,
            # redirects and TLS quirks that Invoke-WebRequest trips over.
            $curl = Join-Path $env:WINDIR 'System32\curl.exe'
            if (Test-Path $curl) {
                Remove-Item $Destination -Force -ErrorAction SilentlyContinue
                $rc = Invoke-Native -FilePath $curl -Label 'curl' -TimeoutSec ($TimeoutSec + 30) -Arguments @(
                    '-L','--fail','--silent','--show-error',
                    '--max-time', "$TimeoutSec",
                    '-o', $Destination,
                    $candidate
                )
                if ($rc -eq 0 -and (Test-Path $Destination) -and ((Get-Item $Destination).Length -ge $MinBytes)) {
                    $mb = [math]::Round((Get-Item $Destination).Length / 1MB, 2)
                    Write-Log "Downloaded $mb MB via curl to $Destination" 'SUCCESS'
                    return $true
                }
                Write-Log "  curl fallback did not produce a valid file (exit $rc)." 'WARN'
            }

            Start-Sleep -Seconds (5 * $attempt)
        }

        Write-Log "Source $sourceNumber exhausted - moving to the next one." 'WARN'
    }

    Remove-Item $Destination -Force -ErrorAction SilentlyContinue
    Write-Log "Every download source failed. Tried: $($Url -join ' | ')" 'ERROR'
    return $false
}

<#
    Authenticode gate.

    A brand-new image often cannot build a full trust chain yet (no root/CTL
    updates fetched), which surfaces as UnknownError even for a perfectly good
    Google or Slack installer - and that would silently block every install.
    So: a bad signature is always fatal, but an unverifiable chain is tolerated
    when the signer subject matches the publisher we expect.
#>
function Test-InstallerSignature {
    param(
        [Parameter(Mandatory)][string]$Path,
        # Several accepted publishers - vendors get acquired and re-sign under
        # the new parent's name (Slack now signs as Salesforce, for instance).
        [string[]]$ExpectedSubject = @()
    )

    $name = Split-Path $Path -Leaf

    try {
        $sig = Get-AuthenticodeSignature -FilePath $Path -ErrorAction Stop
    }
    catch {
        Write-Log "Could not read the signature of $name : $($_.Exception.Message)" 'ERROR'
        return $false
    }

    $subject = if ($sig.SignerCertificate) { $sig.SignerCertificate.Subject } else { '' }

    $publisherOk = $true
    if ($ExpectedSubject.Count -gt 0) {
        $publisherOk = $false
        foreach ($expected in $ExpectedSubject) {
            if ($subject -like "*$expected*") { $publisherOk = $true; break }
        }
    }

    if ($sig.Status -eq 'Valid') {
        Write-Log "Signature valid: $subject"
        if (-not $publisherOk) {
            Write-Log "Signed, but by an unexpected publisher. Expected one of: $($ExpectedSubject -join ', ')" 'ERROR'
            return $false
        }
        return $true
    }

    # Chain could not be evaluated - tolerated only with a matching publisher.
    if ($sig.Status -eq 'UnknownError' -and $publisherOk -and $subject) {
        Write-Log "$name : chain could not be validated (UnknownError) but it is signed by $subject - accepting." 'WARN'
        Write-Log 'If this keeps happening, the image is missing root certificate updates.' 'WARN'
        return $true
    }

    Write-Log "Signature check FAILED for $name : status=$($sig.Status) signer=$subject" 'ERROR'
    return $false
}

<#
    Works out a working Slack machine-wide MSI URL.

    Slack has no stable "latest MSI" link - the old slack.com/ssb/download-win64-msi
    redirect now 404s, which is exactly why Slack stopped installing - and MSI
    builds are published for only SOME versions, lagging the app releases. So
    the release feed is read and candidate URLs are probed with a HEAD request
    until one answers 200.
#>
function Get-SlackMsiUrl {

    $pinned = 'https://downloads.slack-edge.com/desktop-releases/windows/x64/4.48.102/slack-standalone-4.48.102.0.msi'
    $candidates = @()

    try {
        $rss = Invoke-WebRequest -Uri 'https://slack.com/release-notes/windows/rss' -UseBasicParsing -TimeoutSec 60 -ErrorAction Stop
        $versions = [regex]::Matches($rss.Content, '\b(\d+\.\d+\.\d+)\b') | ForEach-Object { $_.Groups[1].Value }
        $versions = @($versions | Select-Object -Unique | Select-Object -First 15)
        Write-Log "Slack release feed returned $($versions.Count) candidate version(s)."
        foreach ($v in $versions) {
            $candidates += "https://downloads.slack-edge.com/desktop-releases/windows/x64/$v/slack-standalone-$v.0.msi"
        }
    }
    catch {
        Write-Log "Could not read the Slack release feed: $($_.Exception.Message)" 'WARN'
    }

    $candidates += $pinned

    foreach ($u in $candidates) {
        try {
            $r = Invoke-WebRequest -Uri $u -Method Head -UseBasicParsing -TimeoutSec 20 -ErrorAction Stop
            if ($r.StatusCode -eq 200) {
                Write-Log "Slack MSI available: $u" 'SUCCESS'
                return $u
            }
        }
        catch { }   # 404 for versions with no MSI build - expected, keep probing
    }

    Write-Log 'No Slack MSI URL responded - falling back to the pinned version.' 'WARN'
    return $pinned
}

<#
    Finds an installed app by display name.

    Searches the machine hives AND every loaded user hive. Per-user installs
    (Slack, Teams, Zoom and friends put themselves in HKCU) are invisible to an
    HKLM-only search, which makes a script reinstall software that is already
    there.
#>
function Get-InstalledApp {
    param([Parameter(Mandatory)][string]$NameLike)

    $keys = @(
        'HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall\*',
        'HKLM:\SOFTWARE\WOW6432Node\Microsoft\Windows\CurrentVersion\Uninstall\*'
    )

    Get-ChildItem 'Registry::HKEY_USERS' -ErrorAction SilentlyContinue |
        Where-Object { $_.PSChildName -match '^S-1-5-21-\d+-\d+-\d+-\d+$' } |
        ForEach-Object {
            $keys += "Registry::HKEY_USERS\$($_.PSChildName)\Software\Microsoft\Windows\CurrentVersion\Uninstall\*"
            $keys += "Registry::HKEY_USERS\$($_.PSChildName)\Software\WOW6432Node\Microsoft\Windows\CurrentVersion\Uninstall\*"
        }

    foreach ($k in $keys) {
        $hit = Get-ItemProperty -Path $k -ErrorAction SilentlyContinue |
               Where-Object { $_.DisplayName -like $NameLike } |
               Select-Object -First 1
        if ($hit) { return $hit }
    }
    return $null
}

<#
    True if any user profile on the box contains the given relative path.
    Catches per-user installs that leave nothing in a machine hive.
#>
function Test-PerUserPath {
    param([Parameter(Mandatory)][string]$RelativePath)

    $profileRoot = Split-Path $env:PUBLIC -Parent
    if (-not (Test-Path $profileRoot)) { $profileRoot = 'C:\Users' }

    $hit = Get-ChildItem -Path $profileRoot -Directory -ErrorAction SilentlyContinue |
           Where-Object { $_.Name -notin @('Public','All Users','Default','Default User') } |
           ForEach-Object { Join-Path $_.FullName $RelativePath } |
           Where-Object { Test-Path $_ } |
           Select-Object -First 1

    return [bool]$hit
}

<#
    True if a matching Appx/MSIX package is installed for any user.
#>
function Test-AppxInstalled {
    param([Parameter(Mandatory)][string]$NameLike)
    try {
        return [bool](@(Get-AppxPackage -AllUsers -ErrorAction SilentlyContinue |
                        Where-Object { $_.Name -like $NameLike }).Count -gt 0)
    } catch { return $false }
}

