<#
    Is the team deployment code ACTUALLY applied to this Streamer?

    Evidence only - no state markers.

    An earlier version of this script also accepted a marker file that the
    script itself wrote after a successful INSTALL, which is not the same thing
    as the code having been applied. That made the check self-certifying: every
    run after the first read its own marker, reported "already enrolled", and
    silently left Streamers sitting there without their deployment code. That
    is the bug that let an unconfigured Streamer through.

    Value names differ between Streamer builds, so rather than guessing a name
    this walks the whole Splashtop key tree for any value whose DATA is the
    deployment code, then falls back to scanning the config files.
#>
function Test-SplashtopDeployCode {
    param([Parameter(Mandatory)][string]$Code)

    foreach ($p in $Script:SplashtopRegPaths) {

        if (-not (Test-Path $p)) { continue }

        $keys = @()
        $keys += @(Get-Item -Path $p -ErrorAction SilentlyContinue)
        $keys += @(Get-ChildItem -Path $p -Recurse -ErrorAction SilentlyContinue)

        foreach ($k in $keys) {
            if (-not $k) { continue }
            try { $names = $k.GetValueNames() } catch { continue }
            foreach ($valueName in $names) {
                try { $data = "$($k.GetValue($valueName))" } catch { continue }
                if ($data -eq $Code) {
                    Write-Log "Deployment code found in registry: $($k.Name) -> $valueName" 'SUCCESS'
                    return $true
                }
            }
        }
    }

    foreach ($f in $Script:SplashtopFolders) {
        if (-not (Test-Path $f)) { continue }
        try {
            $hit = Get-ChildItem -Path $f -Include '*.ini','*.xml','*.cfg','*.json','*.txt' -Recurse -File -ErrorAction SilentlyContinue | Select-String -SimpleMatch -Pattern $Code -ErrorAction SilentlyContinue | Select-Object -First 1
            if ($hit) {
                Write-Log "Deployment code found in config file: $($hit.Path)" 'SUCCESS'
                return $true
            }
        } catch { }
    }

    return $false
}

<#
    Sends a BitLocker recovery key to the Google Sheet escrow.

    The endpoint is an Apps Script web app that ONLY appends/updates rows - it
    cannot read the sheet back - so a compromised laptop cannot enumerate other
    devices' keys. See Knix-BitLocker-Sheet.gs for the code to deploy.

    URL and secret come from the environment (KNIX_SHEET_URL / KNIX_SHEET_SECRET)
    so neither is ever committed to the repo.
#>
function Send-BitLockerKeyToSheet {
    param(
        [Parameter(Mandatory)][string]$Computer,
        [Parameter(Mandatory)][string]$Serial,
        [Parameter(Mandatory)][string]$RecoveryKey,
        [string]$KeyId = '',
        [int]$TimeoutSec = 30
    )

    if ([string]::IsNullOrWhiteSpace($BitLockerSheetUrl)) {
        Write-Log 'No BitLocker sheet URL configured - skipping escrow to Google Sheets.'
        return $false
    }

    $payload = @{
        secret   = $BitLockerSheetSecret
        computer = $Computer
        serial   = $Serial
        key      = $RecoveryKey
        keyId    = $KeyId
    }

    for ($attempt = 1; $attempt -le 3; $attempt++) {
        try {
            $body = $payload | ConvertTo-Json -Compress
            $bytes = [Text.Encoding]::UTF8.GetBytes($body)

            $response = Invoke-RestMethod -Uri $BitLockerSheetUrl -Method Post -ContentType 'application/json; charset=utf-8' -Body $bytes -TimeoutSec $TimeoutSec -UseBasicParsing -ErrorAction Stop

            if ($response.ok) {
                Write-Log "Recovery key escrowed to the Google Sheet ($($response.action))." 'SUCCESS'
                return $true
            }

            Write-Log "Sheet endpoint rejected the write: $($response.error)" 'WARN'
            return $false
        }
        catch {
            Write-Log "Sheet escrow attempt $attempt failed: $($_.Exception.Message)" 'WARN'
            Start-Sleep -Seconds (3 * $attempt)
        }
    }

    Write-Log 'Could not escrow the recovery key to the Google Sheet.' 'ERROR'
    return $false
}

<#
    Post-flight verification.

    Deliberately independent of the step results: it re-reads the machine's
    actual state, so a step that reported success but did not really land is
    still caught. This is what the "device ready" Slack confirmation is based on.

    Healthy values: $true = good, $false = broken, 'SKIPPED' = not evaluated.
#>
function Get-DeviceHealth {

    $checks = New-Object System.Collections.ArrayList

    function Add-HealthCheck {
        param([string]$Name, $Healthy, [string]$Detail)
        [void]$checks.Add([pscustomobject]@{ Name = $Name; Healthy = $Healthy; Detail = $Detail })
    }

    # --- Malwarebytes -------------------------------------------------------
    try {
        if ($Skip -contains 'Malwarebytes') {
            Add-HealthCheck 'Malwarebytes' 'SKIPPED' 'skipped by parameter'
        }
        else {
            $svc = Get-Service -Name 'MBEndpointAgent' -ErrorAction SilentlyContinue
            if ($svc -and $svc.Status -eq 'Running')      { Add-HealthCheck 'Malwarebytes' $true  'agent service running' }
            elseif ($svc)                                  { Add-HealthCheck 'Malwarebytes' $false "agent service is $($svc.Status)" }
            elseif (Get-InstalledApp -NameLike '*Malwarebytes*Endpoint*') { Add-HealthCheck 'Malwarebytes' $false 'installed but no agent service' }
            else                                           { Add-HealthCheck 'Malwarebytes' $false 'not installed' }
        }
    } catch { Add-HealthCheck 'Malwarebytes' $false "check error: $($_.Exception.Message)" }

    # --- Splashtop ----------------------------------------------------------
    try {
        if ($Skip -contains 'Splashtop') {
            Add-HealthCheck 'Splashtop' 'SKIPPED' 'skipped by parameter'
        }
        else {
            $present  = Test-SplashtopInstalled
            $enrolled = if ($present) { Test-SplashtopDeployCode -Code $SplashtopDeployCode } else { $false }
            $running  = [bool](Get-Service -ErrorAction SilentlyContinue |
                        Where-Object { $_.DisplayName -like '*Splashtop*' -and $_.Status -eq 'Running' })

            if     (-not $present)  { Add-HealthCheck 'Splashtop' $false 'not installed' }
            elseif (-not $enrolled) { Add-HealthCheck 'Splashtop' $false "deployment code $SplashtopDeployCode NOT applied" }
            elseif (-not $running)  { Add-HealthCheck 'Splashtop' $false 'deploy code applied but service not running' }
            else                    { Add-HealthCheck 'Splashtop' $true  "installed, deploy code $SplashtopDeployCode applied, service running" }
        }
    } catch { Add-HealthCheck 'Splashtop' $false "check error: $($_.Exception.Message)" }

    # --- Core apps ----------------------------------------------------------
    $appChecks = @(
        @{ Name = 'Google Chrome'; Test = {
               (Test-Path 'C:\Program Files\Google\Chrome\Application\chrome.exe') -or
               (Test-Path 'C:\Program Files (x86)\Google\Chrome\Application\chrome.exe') -or
               [bool](Get-InstalledApp -NameLike 'Google Chrome') } },
        @{ Name = 'Slack'; Test = {
               [bool](Get-InstalledApp -NameLike '*Slack*') -or
               (Test-Path 'C:\Program Files\Slack\slack.exe') -or
               (Test-PerUserPath -RelativePath 'AppData\Local\slack\slack.exe') -or
               (Test-AppxInstalled -NameLike '*Slack*') } },
        @{ Name = 'Google Drive'; Test = {
               [bool](Get-ChildItem 'C:\Program Files\Google\Drive File Stream' -Filter 'GoogleDriveFS.exe' -Recurse -ErrorAction SilentlyContinue | Select-Object -First 1) } }
    )

    foreach ($a in $appChecks) {
        try {
            if ($Skip -contains 'CoreApps') { Add-HealthCheck $a.Name 'SKIPPED' 'skipped by parameter'; continue }
            if (& $a.Test) { Add-HealthCheck $a.Name $true 'installed' }
            else           { Add-HealthCheck $a.Name $false 'NOT installed' }
        } catch { Add-HealthCheck $a.Name $false "check error: $($_.Exception.Message)" }
    }

    # --- Lenovo AI purged ---------------------------------------------------
    # Inverted check: anything still present is a FAILURE.
    try {
        if ($Skip -contains 'RemoveLenovoAI') {
            Add-HealthCheck 'Lenovo AI purged' 'SKIPPED' 'skipped by parameter'
        }
        else {
            $names = @()
            foreach ($pattern in $LenovoAiPatterns) {
                $names += @(Get-AppxPackage -AllUsers -ErrorAction SilentlyContinue |
                            Where-Object { $_.Name -like $pattern } | ForEach-Object { $_.Name })
                $names += @(Get-AppxProvisionedPackage -Online -ErrorAction SilentlyContinue |
                            Where-Object { $_.DisplayName -like $pattern } | ForEach-Object { "$($_.DisplayName) (provisioned)" })
                $w = Get-UninstallEntry -NameLike $pattern
                if ($w) { $names += @($w | ForEach-Object { $_.DisplayName }) }
            }
            $names = @($names | Sort-Object -Unique)
            if ($names.Count -gt 0) { Add-HealthCheck 'Lenovo AI purged' $false "still present: $($names -join ', ')" }
            else                    { Add-HealthCheck 'Lenovo AI purged' $true  'no Lenovo AI components found' }
        }
    } catch { Add-HealthCheck 'Lenovo AI purged' $false "check error: $($_.Exception.Message)" }

    # --- Service desk shortcut ---------------------------------------------
    try {
        if ($Skip -contains 'ServiceDesk') {
            Add-HealthCheck 'Service Desk link' 'SKIPPED' 'skipped by parameter'
        }
        else {
            $pub = Join-Path $env:PUBLIC 'Desktop\Knix Service Desk.url'
            if (Test-Path $pub) { Add-HealthCheck 'Service Desk link' $true  'present on public desktop' }
            else                { Add-HealthCheck 'Service Desk link' $false 'missing from public desktop' }
        }
    } catch { Add-HealthCheck 'Service Desk link' $false "check error: $($_.Exception.Message)" }

    # --- Wallpaper ----------------------------------------------------------
    try {
        if ($Skip -contains 'Wallpaper') {
            Add-HealthCheck 'Wallpaper' 'SKIPPED' 'skipped by parameter'
        }
        else {
            $img = Join-Path $Script:Root 'Branding\wallpaper.jpg'
            if (-not (Test-Path $img)) {
                Add-HealthCheck 'Wallpaper' $false 'image not deployed'
            }
            else {
                $hives = @(Get-ChildItem 'Registry::HKEY_USERS' -ErrorAction SilentlyContinue |
                           Where-Object { $_.PSChildName -match '^S-1-5-21-\d+-\d+-\d+-\d+$' })
                if ($hives.Count -eq 0) {
                    Add-HealthCheck 'Wallpaper' $true 'image staged; applies at first logon'
                }
                else {
                    $applied = $hives | Where-Object {
                        (Get-ItemProperty "Registry::HKEY_USERS\$($_.PSChildName)\Control Panel\Desktop" -Name Wallpaper -ErrorAction SilentlyContinue).Wallpaper -eq $img
                    }
                    if ($applied) { Add-HealthCheck 'Wallpaper' $true  "applied to $(@($applied).Count) of $($hives.Count) profile(s)" }
                    else          { Add-HealthCheck 'Wallpaper' $false 'image present but not set on any profile' }
                }
            }
        }
    } catch { Add-HealthCheck 'Wallpaper' $false "check error: $($_.Exception.Message)" }

    # --- BitLocker ----------------------------------------------------------
    try {
        if ($Skip -contains 'BitLocker') {
            Add-HealthCheck 'BitLocker' 'SKIPPED' 'skipped by parameter'
        }
        elseif (-not (Get-Command Get-BitLockerVolume -ErrorAction SilentlyContinue)) {
            Add-HealthCheck 'BitLocker' 'SKIPPED' 'cmdlets unavailable on this edition'
        }
        else {
            $v = Get-BitLockerVolume -MountPoint 'C:' -ErrorAction Stop
            $hasKey = [bool]($v.KeyProtector | Where-Object { $_.KeyProtectorType -eq 'RecoveryPassword' })

            if ($v.ProtectionStatus -eq 'On' -and $v.VolumeStatus -eq 'FullyEncrypted' -and $hasKey) {
                Add-HealthCheck 'BitLocker' $true 'fully encrypted, protection on, recovery key present'
            }
            elseif ($v.ProtectionStatus -eq 'On' -and $hasKey) {
                Add-HealthCheck 'BitLocker' $true "encrypting ($($v.EncryptionPercentage)%), protection on"
            }
            elseif (-not $hasKey) {
                Add-HealthCheck 'BitLocker' $false "no recovery password protector (status $($v.VolumeStatus))"
            }
            else {
                Add-HealthCheck 'BitLocker' $false "protection $($v.ProtectionStatus), volume $($v.VolumeStatus)"
            }
        }
    } catch { Add-HealthCheck 'BitLocker' $false "check error: $($_.Exception.Message)" }

    return $checks
}

function Get-LoggedOnUser {
    # quser.exe is avoided on purpose: under SYSTEM in session 0 it can block
    # or return nothing. Owner of explorer.exe is reliable and fast.
    $users = @()
    try {
        $procs = Get-CimInstance -ClassName Win32_Process -Filter "Name='explorer.exe'" -ErrorAction Stop
        foreach ($p in $procs) {
            try {
                $owner = Invoke-CimMethod -InputObject $p -MethodName GetOwner -ErrorAction Stop
                if ($owner.User) {
                    $account = if ($owner.Domain) { "$($owner.Domain)\$($owner.User)" } else { $owner.User }
                    if ($users -notcontains $account) { $users += $account }
                }
            } catch { }
        }
    }
    catch {
        Write-Log "Could not enumerate logged-on users: $($_.Exception.Message)" 'WARN'
    }
    return $users
}

