function Set-RegValueIfDifferent {
    <# Returns $true if it actually changed something (idempotency signal). #>
    param(
        [Parameter(Mandatory)][string]$Path,
        [Parameter(Mandatory)][string]$Name,
        [Parameter(Mandatory)]$Value,
        [string]$Type = 'String'
    )
    if (-not (Test-Path $Path)) { New-Item -Path $Path -Force -ErrorAction SilentlyContinue | Out-Null }
    $current = (Get-ItemProperty -Path $Path -Name $Name -ErrorAction SilentlyContinue).$Name
    if ($null -ne $current -and "$current" -eq "$Value") { return $false }
    Set-ItemProperty -Path $Path -Name $Name -Value $Value -Type $Type -Force -ErrorAction SilentlyContinue
    return $true
}

<#
    The isolation wrapper. Nothing a step does - throw, exit-style error, native
    failure - can escape this. Every step is recorded in the summary table.
#>
function Invoke-Step {
    param(
        [Parameter(Mandatory)][string]$Name,
        [Parameter(Mandatory)][scriptblock]$Body
    )

    if ($Skip -contains $Name) {
        [void]$Script:Results.Add([pscustomobject]@{
            Step = $Name; Status = 'SKIPPED'; Detail = 'Skipped by parameter'; Seconds = 0
        })
        Write-Log "=== $Name : skipped by parameter ===" 'WARN'
        return
    }

    Write-Log "================ STEP: $Name ================" 'STEP'
    $sw = [Diagnostics.Stopwatch]::StartNew()
    $status = 'FAILED'
    $detail = ''

    try {
        $result = & $Body
        # A step body can emit stray output; the contract is that the LAST
        # thing it returns is the status hashtable.
        if ($result -is [System.Array] -and $result.Count -gt 0) { $result = $result[-1] }
        if ($result -is [hashtable]) {
            $status = $result.Status
            $detail = $result.Detail
        }
        else {
            $status = 'OK'
            $detail = "$result"
        }
    }
    catch {
        $status = 'FAILED'
        $detail = $_.Exception.Message
        Write-Log "$Name threw: $($_.Exception.Message)" 'ERROR'
        Write-Log "At: $($_.ScriptStackTrace)" 'ERROR'
    }

    $sw.Stop()
    [void]$Script:Results.Add([pscustomobject]@{
        Step    = $Name
        Status  = $status
        Detail  = $detail
        Seconds = [math]::Round($sw.Elapsed.TotalSeconds, 1)
    })
    Write-Log "=== $Name finished: $status ($([math]::Round($sw.Elapsed.TotalSeconds,1))s) - $detail ===" $(if ($status -eq 'FAILED') { 'ERROR' } else { 'SUCCESS' })

    # Immediate Slack alert, if asked for. Wrapped so a Slack outage cannot
    # turn into an onboarding failure.
    if ($status -eq 'FAILED' -and $SlackPerStep) {
        try { Send-SlackStepFailure -StepName $Name -Detail $detail }
        catch { Write-Log "Per-step Slack alert failed: $($_.Exception.Message)" 'WARN' }
    }
}

