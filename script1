# ============================================================================
# STEP 1 - MALWAREBYTES / THREATDOWN ENDPOINT AGENT
# Runs first so endpoint protection is never blocked by a later failure.
# ============================================================================

Invoke-Step -Name 'Malwarebytes' -Body {

    $installed = Get-InstalledApp -NameLike '*Malwarebytes*Endpoint*'
    $svc       = Get-Service -Name 'MBEndpointAgent' -ErrorAction SilentlyContinue

    if ($installed -or $svc) {
        Write-Log 'Malwarebytes Endpoint Agent already installed.'

        if ($svc -and $svc.Status -ne 'Running') {
            Write-Log 'MBEndpointAgent service is not running - starting it.' 'WARN'
            try { Start-Service -Name 'MBEndpointAgent' -ErrorAction Stop }
            catch { Write-Log "Could not start MBEndpointAgent: $($_.Exception.Message)" 'WARN' }
        }

        $eaCmd = 'C:\Program Files\Malwarebytes Endpoint Agent\UserAgent\EACmd.exe'
        if (Test-Path $eaCmd) {
            Invoke-Native -FilePath $eaCmd -Arguments @('-refreshagentinfo') -TimeoutSec 120 -Label 'EACmd-refresh' | Out-Null
        }
        return @{ Status = 'ALREADY OK'; Detail = 'Agent present; service checked' }
    }

    $msi = Join-Path $Script:TempDir 'ThreatDownEA.msi'
    if (-not (Invoke-Download -Url 'https://ark.mwbsys.com/epa.win.installer.x64/release' -Destination $msi -MinBytes 1MB -TimeoutSec 600)) {
        return @{ Status = 'FAILED'; Detail = 'Installer download failed' }
    }

    Wait-ForMsiIdle -TimeoutSec 180 | Out-Null

    $ok = Invoke-MsiInstall -MsiPath $msi -Label 'malwarebytes' -TimeoutSec 1200 -Properties @(
        "NEBULA_ACCOUNTTOKEN=$MalwarebytesToken",
        "GROUP=$MalwarebytesGroupId"
    )

    Remove-Item $msi -Force -ErrorAction SilentlyContinue

    if (-not $ok) { return @{ Status = 'FAILED'; Detail = 'msiexec reported failure' } }

    # Verify with retries - the service takes a moment to register.
    $verified = $false
    for ($i = 1; $i -le 10; $i++) {
        Start-Sleep -Seconds 6
        if (Get-Service -Name 'MBEndpointAgent' -ErrorAction SilentlyContinue) { $verified = $true; break }
        if (Get-InstalledApp -NameLike '*Malwarebytes*Endpoint*')             { $verified = $true; break }
        Write-Log "Malwarebytes verification attempt $i of 10..."
    }

    if (-not $verified) {
        return @{ Status = 'FAILED'; Detail = 'Installed but agent not detected' }
    }

    $eaCmd = 'C:\Program Files\Malwarebytes Endpoint Agent\UserAgent\EACmd.exe'
    if (Test-Path $eaCmd) {
        Invoke-Native -FilePath $eaCmd -Arguments @('-refreshagentinfo')  -TimeoutSec 120 -Label 'EACmd-refresh' | Out-Null
        Invoke-Native -FilePath $eaCmd -Arguments @('-updateprotection') -TimeoutSec 300 -Label 'EACmd-update'  | Out-Null
    }

    return @{ Status = 'INSTALLED'; Detail = 'Agent installed and enrolled to group' }
}

# ============================================================================
# STEP 2 - SPLASHTOP STREAMER
# Fix for "installs but then asks for the deployment code": the code has to be
# passed to the installer as dcode=<code> inside the /i parameter string. The
# old script relied on the code being embedded in the EXE and passed nothing.
# ============================================================================

Invoke-Step -Name 'Splashtop' -Body {


    $isInstalled = Test-SplashtopInstalled
    $isEnrolled  = if ($isInstalled) { Test-SplashtopDeployCode -Code $SplashtopDeployCode } else { $false }

    if ($isInstalled -and $isEnrolled) {
        $svc = Get-Service -ErrorAction SilentlyContinue |
               Where-Object { $_.Name -like '*SplashtopRemote*' -or $_.DisplayName -like '*Splashtop*' }
        foreach ($s in $svc) {
            Write-Log "Splashtop service: $($s.DisplayName) [$($s.Status)]"
            if ($s.Status -ne 'Running' -and $s.StartType -ne 'Disabled') {
                try { Start-Service -Name $s.Name -ErrorAction Stop; Write-Log "Started $($s.Name)." }
                catch { Write-Log "Could not start $($s.Name): $($_.Exception.Message)" 'WARN' }
            }
        }
        return @{ Status = 'ALREADY OK'; Detail = 'Installed and enrolled with deployment code' }
    }

    if ($isInstalled -and -not $isEnrolled) {
        Write-Log 'Splashtop is installed but not enrolled - re-running installer with dcode to enrol in place.' 'WARN'
    }

    $exe = Join-Path $Script:TempDir 'SplashtopStreamer.exe'
    if (-not (Invoke-Download -Url $SplashtopInstallerUrl -Destination $exe -MinBytes 20MB -TimeoutSec 900)) {
        return @{ Status = 'FAILED'; Detail = 'Installer download failed' }
    }

    if (-not (Test-InstallerSignature -Path $exe)) {
        Remove-Item $exe -Force -ErrorAction SilentlyContinue
        return @{ Status = 'FAILED'; Detail = 'Installer signature not valid - refused to run' }
    }

    # Splashtop Easy Deployment syntax. dcode= is what stops the Streamer from
    # prompting for the deployment code after install.
    #
    # The installer routinely does NOT exit - it starts the Streamer and stays
    # resident - so waiting on the process is how this used to hang for the
    # full timeout. Success is polled for instead: the moment the Streamer is
    # detected on disk, the install is done and we stop waiting.
    #
    # NOTE: no uninstall first. Re-running over an existing install applies the
    # new deployment configuration and keeps the machine reachable throughout.
    $argSets = @(
        @('prevercheck','/s','/i', "dcode=$SplashtopDeployCode,confirm_d=0,hidewindow=1"),
        @('/s','/i', "dcode=$SplashtopDeployCode,confirm_d=0,hidewindow=1"),
        @('/s','/i', 'confirm_d=0,hidewindow=1'),   # deploy package: code is embedded
        @('/s')
    )

    $installOk = $false
    $attempt = 0

    foreach ($set in $argSets) {

        $attempt++

        $result = Invoke-NativeUntil -FilePath $exe -Arguments $set -Label "splashtop-$attempt" -TimeoutSec 420 -PollSeconds 5 -GraceSeconds 45 -SuccessTest { Test-SplashtopInstalled }

        if ($result.Success) {
            Write-Log "Splashtop installed on attempt $attempt in $($result.Seconds)s (exit $($result.ExitCode), killed=$($result.Killed))." 'SUCCESS'
            if ($result.ExitCode -in @(1641, 3010)) { $Script:RebootNeeded = $true }
            $installOk = $true
            break
        }

        Write-Log "Splashtop attempt $attempt did not install (exit $($result.ExitCode)) - trying the next argument set." 'WARN'
        Start-Sleep -Seconds 5
    }

    Remove-Item $exe -Force -ErrorAction SilentlyContinue

    if (-not $installOk) {
        return @{ Status = 'FAILED'; Detail = 'Installer did not return a success code' }
    }

    $verified = $false
    for ($i = 1; $i -le 10; $i++) {
        Start-Sleep -Seconds 5
        if (Test-SplashtopInstalled) { $verified = $true; break }
        Write-Log "Splashtop verification attempt $i of 10..."
    }

    if (-not $verified) {
        return @{ Status = 'FAILED'; Detail = 'Installer succeeded but Streamer not detected' }
    }


    $enrolled = Test-SplashtopDeployCode -Code $SplashtopDeployCode
    $svcFound = Get-Service -ErrorAction SilentlyContinue |
                Where-Object { $_.DisplayName -like '*Splashtop*' }
    foreach ($s in $svcFound) { Write-Log "Splashtop service: $($s.DisplayName) [$($s.Status)]" }

    if (-not $svcFound) { Write-Log 'No Splashtop service found after install.' 'WARN' }

    return @{
        Status = 'INSTALLED'
        Detail = "Streamer installed with dcode=$SplashtopDeployCode (enrolment confirmed: $enrolled)"
    }
}

# ============================================================================
# STEP 3 - CORE APPS
# Chocolatey is gone. It needed a bootstrap download, a shell restart for PATH,
# and its Slack package installs per-user, so it could never verify under
# SYSTEM. Vendor enterprise installers are machine-wide and silent by design.
# ============================================================================

Invoke-Step -Name 'CoreApps' -Body {

    # Slack's MSI URL has to be discovered - see Get-SlackMsiUrl.
    $slackMsiUrl = Get-SlackMsiUrl

    $apps = @(
        [pscustomobject]@{
            Name      = 'Google Chrome'
            # Google serves the Enterprise MSI from several paths and rotates
            # which one the download page points at. All three are tried.
            Urls      = @(
                'https://dl.google.com/edgedl/chrome/install/GoogleChromeStandaloneEnterprise64.msi',
                'https://dl.google.com/chrome/install/GoogleChromeStandaloneEnterprise64.msi',
                'https://dl.google.com/dl/chrome/install/googlechromestandaloneenterprise64.msi'
            )
            File      = 'chrome_enterprise.msi'
            Kind      = 'msi'
            MinBytes  = 40MB
            Publisher = @('Google LLC','Google Inc')
            Args      = @()
            Detect    = {
                (Test-Path 'C:\Program Files\Google\Chrome\Application\chrome.exe') -or
                (Test-Path 'C:\Program Files (x86)\Google\Chrome\Application\chrome.exe') -or
                [bool](Get-InstalledApp -NameLike 'Google Chrome')
            }
        },
        [pscustomobject]@{
            Name      = 'Slack'
            Urls      = @($slackMsiUrl)
            File      = 'slack_machine_wide.msi'
            Kind      = 'msi'
            MinBytes  = 10MB
            Publisher = @('Slack Technologies','Salesforce')
            Args      = @()
            Detect    = {
                # Slack installs per-user by default, so a machine-hive-only
                # check reports "missing" on a box that already has it.
                [bool](Get-InstalledApp -NameLike '*Slack*') -or
                (Test-Path 'C:\Program Files\Slack\slack.exe') -or
                (Test-PerUserPath -RelativePath 'AppData\Local\slack\slack.exe') -or
                (Test-AppxInstalled -NameLike '*SlackTechnologies*') -or
                (Test-AppxInstalled -NameLike '*Slack*')
            }
        },
        [pscustomobject]@{
            Name      = 'Google Drive for Desktop'
            Urls      = @(
                'https://dl.google.com/drive-file-stream/GoogleDriveSetup.exe'
            )
            File      = 'GoogleDriveSetup.exe'
            Kind      = 'exe'
            MinBytes  = 15MB
            Publisher = @('Google LLC','Google Inc')
            Args      = @('--silent','--gsuite_shortcuts=false')
            Detect    = {
                (Test-Path 'C:\Program Files\Google\Drive File Stream') -and
                [bool](Get-ChildItem 'C:\Program Files\Google\Drive File Stream' -Filter 'GoogleDriveFS.exe' -Recurse -ErrorAction SilentlyContinue | Select-Object -First 1)
            }
        }
    )

    $installed = @()
    $already   = @()
    $failed    = @()

    foreach ($app in $apps) {

        # --- idempotency check -------------------------------------------------
        if (& $app.Detect) {
            Write-Log "$($app.Name) already present - nothing to do."
            $already += $app.Name
            continue
        }

        Write-Log "$($app.Name) not present - installing."

        $path = Join-Path $Script:TempDir $app.File

        if (-not (Invoke-Download -Url $app.Urls -Destination $path -MinBytes $app.MinBytes -TimeoutSec 900)) {
            Write-Log "$($app.Name): all download sources failed." 'ERROR'
            $failed += "$($app.Name) (download)"
            continue
        }

        if (-not (Test-InstallerSignature -Path $path -ExpectedSubject $app.Publisher)) {
            Write-Log "$($app.Name): refusing to run an installer that failed signature validation." 'ERROR'
            Remove-Item $path -Force -ErrorAction SilentlyContinue
            $failed += "$($app.Name) (signature)"
            continue
        }

        $ok = $false
        if ($app.Kind -eq 'msi') {
            Wait-ForMsiIdle -TimeoutSec 180 | Out-Null
            $ok = Invoke-MsiInstall -MsiPath $path -Label ($app.Name -replace '\s','') -TimeoutSec 1200
        }
        else {
            # Polled, not waited on - a vendor EXE that stays resident after
            # installing would otherwise stall the whole run.
            $detect = $app.Detect
            $res = Invoke-NativeUntil -FilePath $path -Arguments $app.Args -TimeoutSec 900 -GraceSeconds 30 -Label ($app.Name -replace '\s','') -SuccessTest $detect
            if ($res.Success) {
                if ($res.ExitCode -in @(1641, 3010)) { $Script:RebootNeeded = $true }
                $ok = $true
            }
        }

        Remove-Item $path -Force -ErrorAction SilentlyContinue

        if (-not $ok) {
            $failed += "$($app.Name) (installer)"
            continue
        }

        # --- verify (installers can report success and still not land) ---------
        $verified = $false
        for ($i = 1; $i -le 6; $i++) {
            Start-Sleep -Seconds 5
            if (& $app.Detect) { $verified = $true; break }
            Write-Log "$($app.Name) verification attempt $i of 6..."
        }

        if ($verified) {
            Write-Log "$($app.Name) installed and verified." 'SUCCESS'
            $installed += $app.Name
        }
        else {
            Write-Log "$($app.Name) installer succeeded but the app was not detected." 'ERROR'
            $failed += "$($app.Name) (verify)"
        }
    }

    $detailParts = @()
    if ($installed) { $detailParts += "installed: $($installed -join ', ')" }
    if ($already)   { $detailParts += "already ok: $($already -join ', ')" }
    if ($failed)    { $detailParts += "FAILED: $($failed -join ', ')" }
    $detail = $detailParts -join ' | '

    if ($failed.Count -gt 0) { return @{ Status = 'FAILED';     Detail = $detail } }
    if ($installed.Count -eq 0) { return @{ Status = 'ALREADY OK'; Detail = $detail } }
    return @{ Status = 'INSTALLED'; Detail = $detail }
}

# ============================================================================
# STEP 4 - PURGE LENOVO AI (AI Now / Qira)
#
# Removes every trace: Appx packages for all users, the provisioned copy on the
# image (so new profiles do not get it back), Win32 uninstall entries, services,
# running processes and scheduled tasks.
#
# Scope is controlled by -LenovoAiPatterns. Run once with -RemovalDryRun on a
# new model line to see exactly what matches before letting it delete anything.
# ============================================================================

Invoke-Step -Name 'RemoveLenovoAI' -Body {

    $patterns = $LenovoAiPatterns
    Write-Log "Match patterns: $($patterns -join ', ')"
    if ($RemovalDryRun) { Write-Log 'DRY RUN - nothing will actually be removed.' 'WARN' }

    $removed = @()

    # --- 1. Stop processes so files are not locked --------------------------
    $procNames = @()
    foreach ($p in @(Get-Process -ErrorAction SilentlyContinue)) {
        foreach ($pattern in $patterns) {
            if ($p.Name -like $pattern -or $p.Description -like $pattern) { $procNames += $p.Name }
        }
    }
    $procNames = @($procNames | Sort-Object -Unique)
    if ($procNames) {
        $stopped = Stop-ProcessByName -Names $procNames -DryRun:$RemovalDryRun
        if ($stopped) { $removed += "stopped: $($stopped -join ', ')" }
    }

    # --- 2. Stop and delete services ----------------------------------------
    foreach ($pattern in $patterns) {
        $svcs = @(Get-Service -ErrorAction SilentlyContinue |
                  Where-Object { $_.Name -like $pattern -or $_.DisplayName -like $pattern })
        foreach ($svc in $svcs) {
            if ($RemovalDryRun) {
                Write-Log "[DRY RUN] would stop and delete service $($svc.Name) ($($svc.DisplayName))" 'WARN'
                $removed += "service $($svc.Name)"
                continue
            }
            try {
                if ($svc.Status -ne 'Stopped') {
                    Stop-Service -Name $svc.Name -Force -ErrorAction SilentlyContinue
                    Write-Log "Stopped service $($svc.Name)."
                }
                $rc = Invoke-Native -FilePath 'sc.exe' -Arguments @('delete', $svc.Name) -TimeoutSec 60 -Label "sc-delete-$($svc.Name)"
                if ($rc -eq 0) {
                    Write-Log "Deleted service $($svc.Name)." 'SUCCESS'
                    $removed += "service $($svc.Name)"
                }
            }
            catch { Write-Log "Service removal failed for $($svc.Name): $($_.Exception.Message)" 'WARN' }
        }
    }

    # --- 3. Appx packages + provisioning ------------------------------------
    $appxRemoved = Remove-AppxByPattern -Patterns $patterns -DryRun:$RemovalDryRun
    if ($appxRemoved) { $removed += $appxRemoved }

    # --- 4. Win32 uninstall entries -----------------------------------------
    foreach ($pattern in $patterns) {
        $entries = @(Get-UninstallEntry -NameLike $pattern)
        foreach ($entry in $entries) {
            Write-Log "Found Win32 entry: $($entry.DisplayName) $($entry.DisplayVersion) [$($entry.Scope)]"
            if ($RemovalDryRun) {
                $cmdPreview = $entry.QuietUninstallString
                if (-not $cmdPreview) { $cmdPreview = $entry.UninstallString }
                Write-Log "[DRY RUN] would run: $cmdPreview" 'WARN'
                $removed += $entry.DisplayName
                continue
            }
            if (Invoke-UninstallEntry -Entry $entry) {
                $removed += $entry.DisplayName
            }
            elseif (Remove-AppByForce -Entry $entry -DryRun:$RemovalDryRun) {
                # The uninstaller would not run silently from session 0, so the
                # program folder and its registry key are removed directly.
                $removed += "$($entry.DisplayName) (forced)"
            }
        }
    }

    # --- 5. Scheduled tasks --------------------------------------------------
    foreach ($pattern in $patterns) {
        $tasks = @(Get-ScheduledTask -ErrorAction SilentlyContinue |
                   Where-Object { $_.TaskName -like $pattern -or $_.TaskPath -like "*Lenovo*" -and $_.TaskName -like $pattern })
        foreach ($t in $tasks) {
            if ($RemovalDryRun) { Write-Log "[DRY RUN] would remove task $($t.TaskPath)$($t.TaskName)" 'WARN'; continue }
            try {
                Unregister-ScheduledTask -TaskName $t.TaskName -TaskPath $t.TaskPath -Confirm:$false -ErrorAction Stop
                Write-Log "Removed scheduled task $($t.TaskPath)$($t.TaskName)." 'SUCCESS'
                $removed += "task $($t.TaskName)"
            }
            catch { Write-Log "Could not remove task $($t.TaskName): $($_.Exception.Message)" 'WARN' }
        }
    }

    # --- 6. Verify -----------------------------------------------------------
    if ($RemovalDryRun) {
        if ($removed.Count -eq 0) { return @{ Status = 'ALREADY OK'; Detail = 'Dry run: nothing matched' } }
        return @{ Status = 'CHANGED'; Detail = "Dry run: would remove $($removed.Count) item(s) - $(($removed | Select-Object -First 6) -join ', ')" }
    }

    Start-Sleep -Seconds 3

    $leftovers = @()
    foreach ($pattern in $patterns) {
        $leftovers += @(Get-AppxPackage -AllUsers -ErrorAction SilentlyContinue |
                        Where-Object { $_.Name -like $pattern } | ForEach-Object { $_.Name })
        $leftovers += @(Get-AppxProvisionedPackage -Online -ErrorAction SilentlyContinue |
                        Where-Object { $_.DisplayName -like $pattern } | ForEach-Object { "$($_.DisplayName) (provisioned)" })
        $w = Get-UninstallEntry -NameLike $pattern
        if ($w) { $leftovers += @($w | ForEach-Object { $_.DisplayName }) }
    }
    $leftovers = @($leftovers | Sort-Object -Unique)

    if ($leftovers.Count -gt 0) {
        return @{ Status = 'FAILED'; Detail = "Still present after removal: $($leftovers -join ', ')" }
    }

    if ($removed.Count -eq 0) { return @{ Status = 'ALREADY OK'; Detail = 'No Lenovo AI components present' } }
    return @{ Status = 'CHANGED'; Detail = "Purged: $(($removed | Select-Object -First 8) -join ', ')" }
}

# ============================================================================
# STEP 5 - KNIX SERVICE DESK SHORTCUT
# Get-LocalUser is gone - it needs the LocalAccounts module and throws on some
# builds. Profile folders are enumerated directly instead.
# ============================================================================

Invoke-Step -Name 'ServiceDesk' -Body {

    $newName = 'Knix Service Desk.url'
    $oldNames = @('IT Help Desk.url','IT Help Desk.lnk','Knix Service Desk.lnk')

    $content = @"
[InternetShortcut]
URL=$ServiceDeskUrl
IconFile=C:\Windows\System32\shell32.dll
IconIndex=160
"@

    $changed = @()

    # --- 1. Public desktop is the source of truth ---------------------------
    $publicDesktop = Join-Path $env:PUBLIC 'Desktop'
    if (-not (Test-Path $publicDesktop)) { $publicDesktop = 'C:\Users\Public\Desktop' }

    if (Test-Path $publicDesktop) {
        $target = Join-Path $publicDesktop $newName
        $needWrite = $true
        if (Test-Path $target) {
            $existing = (Get-Content $target -Raw -ErrorAction SilentlyContinue)
            if ($existing -and ($existing -replace '\s','') -eq ($content -replace '\s','')) {
                $needWrite = $false
                Write-Log 'Public desktop shortcut already correct.'
            }
        }
        if ($needWrite) {
            $content | Out-File -FilePath $target -Encoding ASCII -Force
            Write-Log "Wrote $target" 'SUCCESS'
            $changed += 'public desktop shortcut'
        }
    }
    else {
        Write-Log "Public desktop not found at $publicDesktop" 'WARN'
    }

    # --- 2. Remove stale copies everywhere ----------------------------------
    $desktops = @()
    if (Test-Path $publicDesktop) { $desktops += $publicDesktop }

    $profileRoot = Split-Path $env:PUBLIC -Parent
    if (-not (Test-Path $profileRoot)) { $profileRoot = 'C:\Users' }

    Get-ChildItem -Path $profileRoot -Directory -ErrorAction SilentlyContinue |
        Where-Object { $_.Name -notin @('Public','Default','Default User','All Users') } |
        ForEach-Object {
            $d = Join-Path $_.FullName 'Desktop'
            if (Test-Path $d) { $desktops += $d }
        }

    foreach ($d in $desktops) {
        foreach ($old in $oldNames) {
            $p = Join-Path $d $old
            if (Test-Path $p) {
                Remove-Item $p -Force -ErrorAction SilentlyContinue
                Write-Log "Removed stale shortcut: $p"
                $changed += "removed $old"
            }
        }
        # A per-user copy of the current shortcut is a duplicate of the public one.
        if ($d -ne $publicDesktop) {
            $dupe = Join-Path $d $newName
            if (Test-Path $dupe) {
                Remove-Item $dupe -Force -ErrorAction SilentlyContinue
                Write-Log "Removed duplicate per-user shortcut: $dupe"
                $changed += 'removed per-user duplicate'
            }
        }
    }

    if ($changed.Count -eq 0) { return @{ Status = 'ALREADY OK'; Detail = 'Shortcut already correct' } }
    return @{ Status = 'CHANGED'; Detail = ($changed | Select-Object -Unique) -join ', ' }
}

# ============================================================================
# STEP 6 - CORPORATE WALLPAPER
# ============================================================================

Invoke-Step -Name 'Wallpaper' -Body {

    $brandDir  = Join-Path $Script:Root 'Branding'
    $imagePath = Join-Path $brandDir 'wallpaper.jpg'
    $tempImage = Join-Path $Script:TempDir 'wallpaper_new.jpg'

    if (-not (Test-Path $brandDir)) { New-Item -Path $brandDir -ItemType Directory -Force | Out-Null }

    $changed = @()

    # --- 1. Fetch only if different ----------------------------------------
    if (-not (Invoke-Download -Url $WallpaperUrl -Destination $tempImage -MinBytes 10KB -TimeoutSec 300)) {
        if (-not (Test-Path $imagePath)) {
            return @{ Status = 'FAILED'; Detail = 'Wallpaper download failed and no local copy exists' }
        }
        Write-Log 'Download failed but a local wallpaper exists - continuing with the existing file.' 'WARN'
    }
    else {
        $newHash = (Get-FileHash $tempImage -Algorithm SHA256).Hash
        $oldHash = if (Test-Path $imagePath) { (Get-FileHash $imagePath -Algorithm SHA256).Hash } else { '' }

        if ($newHash -ne $oldHash) {
            Copy-Item $tempImage $imagePath -Force
            Write-Log 'Wallpaper image updated.' 'SUCCESS'
            $changed += 'image'
        }
        else {
            Write-Log 'Wallpaper image already up to date.'
        }
        Remove-Item $tempImage -Force -ErrorAction SilentlyContinue
    }

    # --- 2. Apply to every loaded user hive ---------------------------------
    Get-ChildItem 'Registry::HKEY_USERS' -ErrorAction SilentlyContinue | ForEach-Object {
        $sid = $_.PSChildName
        if ($sid -notmatch '^S-1-5-21-\d+-\d+-\d+-\d+$') { return }

        $desktopKey = "Registry::HKEY_USERS\$sid\Control Panel\Desktop"
        if (-not (Test-Path $desktopKey)) { return }

        $dirty = $false
        if (Set-RegValueIfDifferent -Path $desktopKey -Name 'Wallpaper'      -Value $imagePath) { $dirty = $true }
        if (Set-RegValueIfDifferent -Path $desktopKey -Name 'WallpaperStyle' -Value '10')       { $dirty = $true }  # 10 = Fill
        if (Set-RegValueIfDifferent -Path $desktopKey -Name 'TileWallpaper'  -Value '0')        { $dirty = $true }

        if ($dirty) {
            Write-Log "Updated wallpaper registry for SID $sid" 'SUCCESS'
            $changed += "hive $sid"
        }
    }

    # --- 3. Apply to the default profile so NEW users get it too ------------
    $defaultHive = 'C:\Users\Default\NTUSER.DAT'
    if (Test-Path $defaultHive) {
        $loaded = $false
        try {
            $rc = Invoke-Native -FilePath 'reg.exe' -TimeoutSec 60 -Label 'reg-load' -Arguments @('load','HKU\KnixDefault', $defaultHive)
            $loaded = ($rc -eq 0)
        } catch { }

        if ($loaded) {
            try {
                $k = 'Registry::HKEY_USERS\KnixDefault\Control Panel\Desktop'
                if (Set-RegValueIfDifferent -Path $k -Name 'Wallpaper'      -Value $imagePath) { $changed += 'default profile' }
                Set-RegValueIfDifferent -Path $k -Name 'WallpaperStyle' -Value '10' | Out-Null
                Set-RegValueIfDifferent -Path $k -Name 'TileWallpaper'  -Value '0'  | Out-Null
                Write-Log 'Default user profile wallpaper configured.'
            }
            finally {
                [gc]::Collect(); [gc]::WaitForPendingFinalizers()
                Start-Sleep -Seconds 2
                Invoke-Native -FilePath 'reg.exe' -Arguments @('unload','HKU\KnixDefault') -TimeoutSec 60 -Label 'reg-unload' | Out-Null
            }
        }
        else {
            Write-Log 'Could not load the default user hive (it may be in use) - skipping.' 'WARN'
        }
    }

    # --- 4. Refresh live sessions, only if something changed ----------------
    $users = Get-LoggedOnUser
    if ($users.Count -eq 0) {
        Write-Log 'No interactive sessions - the wallpaper applies at next logon.'
    }
    elseif ($changed.Count -eq 0) {
        Write-Log 'Nothing changed - no session refresh needed.'
    }
    else {
        foreach ($user in $users) {
            $sid = ConvertTo-Sid -Account $user
            if (-not $sid) { Write-Log "Could not resolve SID for $user - skipping refresh." 'WARN'; continue }

            $taskName = 'Knix_SetWallpaper_' + ($user -replace '[^A-Za-z0-9_-]','_')

            $userScript = @"
Add-Type @'
using System;
using System.Runtime.InteropServices;
public class KnixWallpaper {
    [DllImport("user32.dll", CharSet = CharSet.Auto)]
    private static extern int SystemParametersInfo(int uAction, int uParam, string lpvParam, int fuWinIni);
    public static void Apply(string path) {
        SystemParametersInfo(20, 0, path, 0x01 | 0x02);
    }
}
'@
[KnixWallpaper]::Apply('$imagePath')
"@
            $encoded = [Convert]::ToBase64String([Text.Encoding]::Unicode.GetBytes($userScript))

            try {
                Unregister-ScheduledTask -TaskName $taskName -Confirm:$false -ErrorAction SilentlyContinue

                $action = New-ScheduledTaskAction -Execute 'powershell.exe' -Argument "-NoProfile -NonInteractive -WindowStyle Hidden -EncodedCommand $encoded"
                $principal = New-ScheduledTaskPrincipal -UserId $sid -LogonType Interactive -RunLevel Limited
                $settings  = New-ScheduledTaskSettingsSet -AllowStartIfOnBatteries -DontStopIfGoingOnBatteries -ExecutionTimeLimit (New-TimeSpan -Minutes 2)

                Register-ScheduledTask -TaskName $taskName -Action $action -Principal $principal -Settings $settings -Force -ErrorAction Stop | Out-Null
                Start-ScheduledTask -TaskName $taskName -ErrorAction Stop
                Start-Sleep -Seconds 4
                Write-Log "Wallpaper refreshed in session for $user" 'SUCCESS'
            }
            catch {
                Write-Log "Live refresh failed for $user (applies at next logon): $($_.Exception.Message)" 'WARN'
            }
            finally {
                Unregister-ScheduledTask -TaskName $taskName -Confirm:$false -ErrorAction SilentlyContinue
            }
        }
    }

    if ($changed.Count -eq 0) { return @{ Status = 'ALREADY OK'; Detail = 'Wallpaper already deployed' } }
    return @{ Status = 'CHANGED'; Detail = (($changed | Select-Object -Unique) -join ', ') }
}

# ============================================================================
# STEP 7 - BITLOCKER
# Last on purpose, and it NEVER reboots unless -AllowReboot is passed. The old
# script's "shutdown /r /t 60" is what killed the rest of the Atera chain.
# ============================================================================

Invoke-Step -Name 'BitLocker' -Body {

    if (-not (Get-Command Get-BitLockerVolume -ErrorAction SilentlyContinue)) {
        return @{ Status = 'SKIPPED'; Detail = 'BitLocker cmdlets unavailable (Home edition?)' }
    }

    # --- TPM ---------------------------------------------------------------
    try {
        $tpm = Get-Tpm -ErrorAction Stop
        Write-Log "TPM present=$($tpm.TpmPresent) enabled=$($tpm.TpmEnabled) activated=$($tpm.TpmActivated) owned=$($tpm.TpmOwned)"

        if (-not $tpm.TpmPresent)  { return @{ Status = 'FAILED'; Detail = 'No TPM detected - enable it in BIOS' } }
        if (-not $tpm.TpmEnabled -or -not $tpm.TpmActivated) {
            return @{ Status = 'FAILED'; Detail = 'TPM present but not enabled/activated in BIOS' }
        }
        if (-not $tpm.TpmOwned) {
            Write-Log 'Initialising TPM ownership...'
            try { Initialize-Tpm -AllowClear:$false -AllowPhysicalPresence:$false -ErrorAction Stop | Out-Null }
            catch { Write-Log "Initialize-Tpm: $($_.Exception.Message)" 'WARN' }
            Start-Sleep -Seconds 5
        }
    }
    catch {
        Write-Log "TPM query failed: $($_.Exception.Message) - continuing." 'WARN'
    }

    $vol = Get-BitLockerVolume -MountPoint 'C:' -ErrorAction Stop
    Write-Log "C: VolumeStatus=$($vol.VolumeStatus) ProtectionStatus=$($vol.ProtectionStatus) Encryption=$($vol.EncryptionPercentage)%"
    foreach ($kp in $vol.KeyProtector) { Write-Log "  Existing protector: $($kp.KeyProtectorType)" }

    $actions = @()

    # --- Protectors --------------------------------------------------------
    if (-not ($vol.KeyProtector | Where-Object { $_.KeyProtectorType -eq 'Tpm' })) {
        Write-Log 'Adding TPM protector...'
        try {
            Add-BitLockerKeyProtector -MountPoint 'C:' -TpmProtector -ErrorAction Stop | Out-Null
            $actions += 'added TPM protector'
        }
        catch {
            Write-Log "Add-BitLockerKeyProtector (TPM) failed: $($_.Exception.Message) - trying manage-bde." 'WARN'
            if ((Invoke-Native -FilePath 'manage-bde.exe' -Arguments @('-protectors','-add','C:','-tpm') -TimeoutSec 180 -Label 'bde-tpm') -eq 0) {
                $actions += 'added TPM protector (manage-bde)'
            }
        }
    }

    if (-not ($vol.KeyProtector | Where-Object { $_.KeyProtectorType -eq 'RecoveryPassword' })) {
        Write-Log 'Adding recovery password protector...'
        try {
            Add-BitLockerKeyProtector -MountPoint 'C:' -RecoveryPasswordProtector -ErrorAction Stop | Out-Null
            $actions += 'added recovery password'
        }
        catch {
            Write-Log "Add-BitLockerKeyProtector (RecoveryPassword) failed: $($_.Exception.Message) - trying manage-bde." 'WARN'
            if ((Invoke-Native -FilePath 'manage-bde.exe' -Arguments @('-protectors','-add','C:','-RecoveryPassword') -TimeoutSec 180 -Label 'bde-rp') -eq 0) {
                $actions += 'added recovery password (manage-bde)'
            }
        }
        Start-Sleep -Seconds 3
    }

    $vol = Get-BitLockerVolume -MountPoint 'C:' -ErrorAction Stop

    # --- Encrypt / resume protection ---------------------------------------
    if ($vol.VolumeStatus -eq 'FullyDecrypted') {
        Write-Log 'Drive is not encrypted - starting encryption.'
        try {
            Enable-BitLocker -MountPoint 'C:' -EncryptionMethod XtsAes256 -UsedSpaceOnly -TpmProtector -RecoveryPasswordProtector -SkipHardwareTest -ErrorAction Stop | Out-Null
            $actions += 'encryption started'
        }
        catch {
            Write-Log "Enable-BitLocker failed: $($_.Exception.Message) - trying manage-bde." 'WARN'
            $rc = Invoke-Native -FilePath 'manage-bde.exe' -Arguments @('-on','C:','-UsedSpaceOnly','-SkipHardwareTest') -TimeoutSec 300 -Label 'bde-on'
            if ($rc -eq 0) { $actions += 'encryption started (manage-bde)' }
            else           { Write-Log "manage-bde -on returned $rc" 'ERROR' }
        }
        $Script:RebootNeeded = $true
    }
    elseif ($vol.ProtectionStatus -ne 'On') {
        Write-Log 'Drive is encrypted but protection is OFF - resuming.'
        try {
            Resume-BitLocker -MountPoint 'C:' -ErrorAction Stop | Out-Null
            $actions += 'protection resumed'
        }
        catch {
            Write-Log "Resume-BitLocker failed: $($_.Exception.Message) - trying manage-bde." 'WARN'
            if ((Invoke-Native -FilePath 'manage-bde.exe' -Arguments @('-protectors','-enable','C:') -TimeoutSec 180 -Label 'bde-enable') -eq 0) {
                $actions += 'protection resumed (manage-bde)'
            }
        }
    }
    else {
        Write-Log 'BitLocker is already on and protecting the drive.'
    }

    Start-Sleep -Seconds 5
    $final = Get-BitLockerVolume -MountPoint 'C:' -ErrorAction SilentlyContinue

    # --- Recovery key: escrow first, file second ---------------------------
    $rp = $final.KeyProtector | Where-Object { $_.KeyProtectorType -eq 'RecoveryPassword' } | Select-Object -First 1

    if ($rp -and $rp.RecoveryPassword) {

        # Escrow to Entra ID / Azure AD when the device is joined. This is the
        # correct place for a recovery key - a plaintext file on the box is not.
        $joined = $false
        try {
            $ds = & dsregcmd.exe /status 2>&1
            $joined = [bool]($ds | Select-String -Pattern 'AzureAdJoined\s*:\s*YES' -Quiet)
        } catch { }

        if ($joined) {
            try {
                BackupToAAD-BitLockerKeyProtector -MountPoint 'C:' -KeyProtectorId $rp.KeyProtectorId -ErrorAction Stop
                Write-Log 'Recovery key escrowed to Entra ID.' 'SUCCESS'
                $actions += 'key escrowed to Entra ID'
            }
            catch { Write-Log "Entra ID escrow failed: $($_.Exception.Message)" 'WARN' }
        }
        else {
            Write-Log 'Device is not Entra ID joined - no cloud escrow performed.' 'WARN'
        }

        # Local copy, restricted to SYSTEM + Administrators.
        $keyFile = Join-Path $Script:StateDir 'BitLocker-RecoveryKey.txt'
        try {
            "Computer : $env:COMPUTERNAME`r`nSaved    : $(Get-Date -Format 'yyyy-MM-dd HH:mm:ss')`r`nKeyID    : $($rp.KeyProtectorId)`r`nKey      : $($rp.RecoveryPassword)" |
                Out-File -FilePath $keyFile -Encoding ASCII -Force

            $acl = Get-Acl $keyFile
            $acl.SetAccessRuleProtection($true, $false)
            $acl.Access | ForEach-Object { $acl.RemoveAccessRule($_) | Out-Null }
            foreach ($who in @('NT AUTHORITY\SYSTEM','BUILTIN\Administrators')) {
                $acl.AddAccessRule((New-Object Security.AccessControl.FileSystemAccessRule(
                    $who,'FullControl','Allow')))
            }
            Set-Acl -Path $keyFile -AclObject $acl
            Write-Log "Recovery key written to $keyFile (SYSTEM/Administrators only)."
        }
        catch { Write-Log "Could not write the local recovery key file: $($_.Exception.Message)" 'WARN' }

        # --- Escrow to the Google Sheet -------------------------------------
        $serial = 'unknown'
        try {
            $serial = "$((Get-CimInstance Win32_BIOS -ErrorAction Stop).SerialNumber)".Trim()
        } catch { }

        $escrowed = Send-BitLockerKeyToSheet -Computer $env:COMPUTERNAME -Serial $serial -RecoveryKey $rp.RecoveryPassword -KeyId "$($rp.KeyProtectorId)"

        if ($escrowed) {
            $actions += 'key escrowed to Google Sheet'
            # Safely stored, so the key itself stays out of Atera's run history.
            Write-Log "Recovery key for $env:COMPUTERNAME (serial $serial) is in the Google Sheet. Key ID: $($rp.KeyProtectorId)"
        }
        else {
            # Nowhere else to put it - print it so it is not lost, and say so.
            Write-Log 'Sheet escrow unavailable - printing the key to this output instead.' 'WARN'
            Write-Log "BITLOCKER RECOVERY KEY ($env:COMPUTERNAME / $serial): $($rp.RecoveryPassword)"
        }

        # Old script's insecure drop on the root of C:.
        if (Test-Path 'C:\BitLocker_RecoveryKey.txt') {
            Remove-Item 'C:\BitLocker_RecoveryKey.txt' -Force -ErrorAction SilentlyContinue
            Write-Log 'Removed the old world-readable C:\BitLocker_RecoveryKey.txt.' 'SUCCESS'
            $actions += 'removed insecure key file'
        }
    }
    else {
        Write-Log 'No recovery password protector available to save yet.' 'WARN'
    }

    Write-Log "FINAL: VolumeStatus=$($final.VolumeStatus) ProtectionStatus=$($final.ProtectionStatus) Encryption=$($final.EncryptionPercentage)%"

    if ($final.ProtectionStatus -eq 'On') {
        $detail = if ($actions) { "Protection ON - $($actions -join ', ')" } else { 'Protection ON - already compliant' }
        return @{ Status = $(if ($actions) { 'CHANGED' } else { 'ALREADY OK' }); Detail = $detail }
    }

    $Script:RebootNeeded = $true
    return @{
        Status = 'PENDING'
        Detail = "Status=$($final.VolumeStatus)/$($final.ProtectionStatus) at $($final.EncryptionPercentage)% - reboot required to finish"
    }
}

# ============================================================================
# SUMMARY
# ============================================================================

Write-Log ''
Write-Log '############################################################'
Write-Log "ONBOARDING SUMMARY - $env:COMPUTERNAME"
Write-Log '############################################################'

$failedSteps = @()

foreach ($r in $Script:Results) {
    $line = "{0,-14} {1,-11} {2,6}s  {3}" -f $r.Step, $r.Status, $r.Seconds, $r.Detail
    $lvl  = if ($r.Status -eq 'FAILED') { 'ERROR' } elseif ($r.Status -in @('PENDING','SKIPPED')) { 'WARN' } else { 'SUCCESS' }
    Write-Log $line $lvl
    if ($r.Status -eq 'FAILED') { $failedSteps += $r.Step }
}

if (Test-PendingReboot) { $Script:RebootNeeded = $true }

# ----------------------------------------------------------------------------
# POST-FLIGHT VERIFICATION
# Re-reads the machine's real state so a step that "succeeded" without actually
# landing is still caught before we tell anyone the device is ready.
# ----------------------------------------------------------------------------
Write-Log ''
Write-Log '--------------------- POST-INSTALL CHECKS ------------------'

$health = @()
try   { $health = @(Get-DeviceHealth) }
catch { Write-Log "Health check itself failed: $($_.Exception.Message)" 'ERROR' }

foreach ($h in $health) {
    $mark = switch ($h.Healthy) {
        $true   { 'PASS' }
        $false  { 'FAIL' }
        default { 'SKIP' }
    }
    $lvl = switch ($h.Healthy) {
        $true   { 'SUCCESS' }
        $false  { 'ERROR' }
        default { 'WARN' }
    }
    Write-Log ("{0}  {1,-20} {2}" -f $mark, $h.Name, $h.Detail) $lvl
}

$unhealthy = @($health | Where-Object { $_.Healthy -eq $false })

Write-Log '------------------------------------------------------------'
if ($failedSteps.Count -eq 0 -and $unhealthy.Count -eq 0) {
    Write-Log 'DEVICE READY - every post-install check passed.' 'SUCCESS'
}
else {
    Write-Log "DEVICE NOT READY - $($unhealthy.Count) failed check(s), $($failedSteps.Count) failed step(s)." 'ERROR'
}

Write-Log "Reboot required: $Script:RebootNeeded"
Write-Log "Full log: $Script:LogFile"

# State file so the next run (and you) can see what happened last time.
try {
    [pscustomobject]@{
        LastRun       = (Get-Date -Format 'o')
        Computer      = $env:COMPUTERNAME
        RebootNeeded  = $Script:RebootNeeded
        DeviceReady   = ($failedSteps.Count -eq 0 -and $unhealthy.Count -eq 0)
        Results       = $Script:Results
        Health        = $health
    } | ConvertTo-Json -Depth 4 | Out-File (Join-Path $Script:StateDir 'onboarding-state.json') -Encoding UTF8 -Force
} catch { }

# ----------------------------------------------------------------------------
# SLACK NOTIFICATION
# Sent last, and never allowed to change the script's outcome.
# ----------------------------------------------------------------------------
try {
    Send-SlackSummary -Results @($Script:Results) -Health $health -RebootNeeded $Script:RebootNeeded
}
catch {
    Write-Log "Slack summary failed to send: $($_.Exception.Message)" 'WARN'
}

if ($Script:RebootNeeded -and $AllowReboot) {
    Write-Log 'AllowReboot was set - restarting in 5 minutes.' 'WARN'
    & shutdown.exe /r /t 300 /c 'Knix device setup: restarting to finish configuration.'
}
elseif ($Script:RebootNeeded) {
    Write-Log 'A reboot is needed to finish (BitLocker and/or installers). Reboot via Atera or pass -AllowReboot.' 'WARN'
}

if ($failedSteps.Count -gt 0) {
    Write-Log "FAILED STEPS: $($failedSteps -join ', ')" 'ERROR'
    exit 1
}

if ($unhealthy.Count -gt 0) {
    Write-Log "FAILED CHECKS: $(($unhealthy | ForEach-Object { $_.Name }) -join ', ')" 'ERROR'
    exit 1
}

Write-Log 'All steps completed and every post-install check passed.' 'SUCCESS'
exit 0
